// Development encoding tables matching docs/PIXEL_ENCODING.md.
export fn Identifier(value: int) -> [int] {
    if value < 0 || value > 65535 { fail("Identifier must be from 0 to 65535") }
    return [32, value / 256, value % 256, 255]
}
export fn Names(category: int) -> [string] {
    var names: [string] = []
    if category == 48 { names = ["+", "-", "*", "/", "%", "==", "!=", "<", "<=", ">", ">=", "and", "or", "not"] }
    if category == 64 { names = ["let", "set", "if", "else", "while", "fn", "return", "print", "import", "export", "do", "try", "catch", "for", "in", "record", "var", "entry", "break", "continue", "enum", "variant", "match", "case", "otherwise", "lambda", "lambda_body"] }
    if category == 80 { names = ["(", ")", ",", ":", "=", "->", ".", "[", "]", "{", "}", "@", "+=", "-=", "*=", "/=", "%=", "=>"] }
    if category == 96 { names = ["int", "bool", "str", "unit", "map", "record", "json", "Error", "float64", "parameter", "Option", "function"] }
    if category == 128 { names = ["len", "append", "pop", "slice", "string", "parseInt", "assert", "split", "join", "input", "trim", "replace", "keys", "has", "delete", "fail", "jsonDecode", "jsonParse", "jsonStringify", "jsonKind", "jsonGet", "jsonAt", "jsonAsInt", "jsonAsString", "jsonAsBool", "jsonFrom", "jsonNull", "jsonKeys", "readText", "writeText", "float64", "int", "parseFloat64", "jsonAsFloat64", "lookup", "unicodeCategory", "utf8Encode", "utf8Decode", "float64Bytes", "float64FromBytes", "crc32", "zlibCompress", "zlibDecompress", "readBytes", "writeBytes", "extend", "arrayRepeat"] }
    return names
}
export fn Symbol(category: int, name: string) -> [int] {
    for index, value in Names(category) { if value == name { return [category, index / 256, index % 256, 255] } }
    fail("Unknown semantic token: " + string(category) + ":" + name)
    return []
}
