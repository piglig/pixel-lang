import "model.pxl" as model
import "pixel_ast_state.pxl" as state
import "literal_pixels.pxl" as literals

fn Literal(values: [[int]], colors: inout [[int]]) { for color in values { colors.append(color) } }
fn EnumBase(c: state.Context, index: int, checked: model.ExpressionCheck) -> bool {
    if !c.expressions.has(string(index)) { return false }
    let typeId = c.expressions[string(index)]
    return typeId >= 0 && checked.resolved.types[typeId].kind == "enum"
}
fn Enum(index: int, name: string, arguments: [int], checked: model.ExpressionCheck, c: inout state.Context, colors: inout [[int]]) {
    state.Token(64, "variant", index, checked, &c, &colors); state.Token(80, "(", index, checked, &c, &colors)
    state.Type(state.ExpressionType(index, checked, &c), index, checked, &c, &colors); state.Token(80, ",", index, checked, &c, &colors)
    state.Text(name, index, checked, &c, &colors)
    for argument in arguments { state.Token(80, ",", index, checked, &c, &colors); Emit(argument, checked, &c, &colors) }
    state.Token(80, ")", index, checked, &c, &colors)
}
fn Pattern(index: int, checked: model.ExpressionCheck, c: inout state.Context, colors: inout [[int]]) {
    let nodes = checked.resolved.bound.project.modules[c.module].syntax.nodes
    let pattern = nodes[index]
    if pattern.kind == "wildcard_pattern" { state.Token(64, "otherwise", index, checked, &c, &colors); return }
    if pattern.kind == "binding" { state.Id(state.Declare(index, checked, &c), index, checked, &c, &colors); return }
    state.Type(state.ExpressionType(index, checked, &c), index, checked, &c, &colors)
    state.Text(pattern.text, index, checked, &c, &colors); state.Token(80, "(", index, checked, &c, &colors)
    var first = 0
    if len(pattern.children) > 0 && nodes[pattern.children[0]].kind == "pattern_qualifier" { first = 1 }
    for position, child in slice(pattern.children, first, len(pattern.children)) {
        if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
        Pattern(child, checked, &c, &colors)
    }
    state.Token(80, ")", index, checked, &c, &colors)
}
export fn Subjects(index: int, checked: model.ExpressionCheck, c: inout state.Context, colors: inout [[int]]) {
    let node = checked.resolved.bound.project.modules[c.module].syntax.nodes[index]
    state.Token(80, "(", index, checked, &c, &colors)
    for position, child in node.children {
        if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
        Emit(child, checked, &c, &colors)
    }
    state.Token(80, ")", index, checked, &c, &colors)
}
export fn Patterns(armId: int, checked: model.ExpressionCheck, c: inout state.Context, colors: inout [[int]]) {
    let nodes = checked.resolved.bound.project.modules[c.module].syntax.nodes
    let arm = nodes[armId]
    state.Token(80, "(", armId, checked, &c, &colors)
    for position, child in nodes[arm.children[0]].children {
        if position > 0 { state.Token(80, ",", armId, checked, &c, &colors) }
        Pattern(child, checked, &c, &colors)
    }
    state.Token(80, ")", armId, checked, &c, &colors)
    if len(arm.children) == 3 {
        state.Token(64, "if", armId, checked, &c, &colors)
        Emit(nodes[arm.children[1]].children[0], checked, &c, &colors)
    }
}
export fn Emit(index: int, checked: model.ExpressionCheck, c: inout state.Context, colors: inout [[int]]) {
    if len(c.diagnostics) > 0 { return }
    let resolved = checked.resolved
    let nodes = resolved.bound.project.modules[c.module].syntax.nodes
    let node = nodes[index]
    let children = node.children
    if node.kind == "propagate" {
        state.Token(80, "(", index, checked, &c, &colors); Emit(children[0], checked, &c, &colors)
        state.Token(80, ")", index, checked, &c, &colors); state.Token(80, "?", index, checked, &c, &colors); return
    }
    if node.kind == "context_variant" { Enum(index, node.text, [], checked, &c, &colors); return }
    if node.kind == "lambda" || node.kind == "value_block" {
        var marker = "lambda"
        if node.kind == "value_block" { marker = "value_block" }
        state.Token(64, marker, index, checked, &c, &colors); state.Token(80, "(", index, checked, &c, &colors)
        state.Id(index, index, checked, &c, &colors); state.Token(80, ")", index, checked, &c, &colors)
        c.bodies.append(index); return
    }
    if node.kind == "literal_int" {
        match parseInt(node.text) {
            .Ok(value) => { Literal(literals.Integer(value), &colors) },
            .Err(error) => { state.Report(index, error.message, checked, &c) }
        }
        return
    }
    if node.kind == "literal_float64" {
        match parseFloat64(node.text) {
            .Ok(value) => { Literal(literals.Float(value), &colors) },
            .Err(error) => { state.Report(index, error.message, checked, &c) }
        }
        return
    }
    if node.kind == "literal_str" { state.Text(node.text, index, checked, &c, &colors); return }
    if node.kind == "literal_keyword" { Literal(literals.Boolean(node.text == "true"), &colors); return }
    if node.kind == "match" {
        state.Token(64, "match", index, checked, &c, &colors); Subjects(children[0], checked, &c, &colors); state.Token(80, "{", index, checked, &c, &colors)
        for position, child in slice(children, 1, len(children)) {
            if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            state.Token(64, "case", index, checked, &c, &colors); Patterns(child, checked, &c, &colors); state.Token(80, "=>", index, checked, &c, &colors)
            let arm = nodes[child]
            Emit(arm.children[len(arm.children) - 1], checked, &c, &colors)
        }
        state.Token(80, "}", index, checked, &c, &colors); return
    }
    if node.kind == "annotate" { Emit(children[0], checked, &c, &colors); return }
    if node.kind == "name" {
        let symbol = state.Reference(index, checked, &c)
        if symbol < 0 { return }
        let target = resolved.bound.symbols[symbol]
        if target.kind == "builtin" {
            if target.name == "Error" || target.name == "Option" || target.name == "print" { state.Report(index, "Special builtin pixel emission is not implemented: " + target.name, checked, &c); return }
            state.Token(128, target.name, index, checked, &c, &colors)
        } else { state.Id(symbol, index, checked, &c, &colors) }
        return
    }
    if node.kind == "inout_argument" { state.Token(80, "&", index, checked, &c, &colors); Emit(children[0], checked, &c, &colors); return }
    if node.kind == "unary" {
        let operand = nodes[children[0]]
        if node.text == "-" && operand.kind == "literal_int" {
            match parseInt("-" + operand.text) {
                .Ok(value) => { Literal(literals.Integer(value), &colors) },
                .Err(error) => { state.Report(index, error.message, checked, &c) }
            }
            return
        }
        state.Token(80, "(", index, checked, &c, &colors)
        var op = "not"
        if node.text == "-" { op = "-" }
        state.Token(48, op, index, checked, &c, &colors); Emit(children[0], checked, &c, &colors); state.Token(80, ")", index, checked, &c, &colors); return
    }
    if node.kind == "binary" {
        state.Token(80, "(", index, checked, &c, &colors); Emit(children[0], checked, &c, &colors)
        var op = node.text
        if op == "&&" { op = "and" }
        if op == "||" { op = "or" }
        state.Token(48, op, index, checked, &c, &colors); Emit(children[1], checked, &c, &colors); state.Token(80, ")", index, checked, &c, &colors); return
    }
    if node.kind == "specialize" {
        Emit(children[0], checked, &c, &colors); state.Token(80, "::", index, checked, &c, &colors); state.Token(80, "[", index, checked, &c, &colors)
        for position, child in slice(children, 1, len(children)) {
            if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            state.Type(state.Annotation(child, checked, &c), child, checked, &c, &colors)
        }
        state.Token(80, "]", index, checked, &c, &colors); return
    }
    if node.kind == "field" && EnumBase(c, children[0], checked) { Enum(index, node.text, [], checked, &c, &colors); return }
    if node.kind == "field" && c.references.has(string(index)) {
        let symbol = c.references[string(index)]
        let target = resolved.bound.symbols[symbol]
        state.Id(state.ModuleId(target.module, checked), index, checked, &c, &colors); state.Token(80, ".", index, checked, &c, &colors); state.Id(symbol, index, checked, &c, &colors); return
    }
    if node.kind == "field" { Emit(children[0], checked, &c, &colors); state.Token(80, "@", index, checked, &c, &colors); state.Text(node.text, index, checked, &c, &colors); return }
    if node.kind == "record_update" {
        state.Token(80, "(", index, checked, &c, &colors); Emit(children[0], checked, &c, &colors); state.Token(80, ")", index, checked, &c, &colors)
        state.Token(64, "with", index, checked, &c, &colors); state.Token(80, "{", index, checked, &c, &colors)
        for position, child in slice(children, 1, len(children)) {
            if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            let field = nodes[child]
            state.Text(field.text, index, checked, &c, &colors); state.Token(80, ":", index, checked, &c, &colors)
            if len(field.children) > 0 { Emit(field.children[0], checked, &c, &colors) }
            else { state.Id(state.Reference(child, checked, &c), child, checked, &c, &colors) }
        }
        state.Token(80, "}", index, checked, &c, &colors); return
    }
    if node.kind == "construct" {
        state.Type(state.ExpressionType(index, checked, &c), index, checked, &c, &colors); state.Token(80, "(", index, checked, &c, &colors); state.Token(80, "{", index, checked, &c, &colors)
        for position, child in slice(children, 1, len(children)) {
            if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            let field = nodes[child]
            state.Text(field.text, index, checked, &c, &colors); state.Token(80, ":", index, checked, &c, &colors)
            if len(field.children) > 0 { Emit(field.children[0], checked, &c, &colors) }
            else { state.Id(state.Reference(child, checked, &c), child, checked, &c, &colors) }
        }
        state.Token(80, "}", index, checked, &c, &colors); state.Token(80, ")", index, checked, &c, &colors); return
    }
    if node.kind == "call" {
        let callee = nodes[children[0]]
        if callee.kind == "context_variant" || (callee.kind == "field" && EnumBase(c, callee.children[0], checked)) { Enum(index, callee.text, slice(children, 1, len(children)), checked, &c, &colors); return }
        let imported = callee.kind == "field" && c.references.has(string(children[0]))
        let grouped = callee.kind != "name" && callee.kind != "specialize" && !imported
        if grouped { state.Token(80, "(", index, checked, &c, &colors) }
        Emit(children[0], checked, &c, &colors)
        if grouped { state.Token(80, ")", index, checked, &c, &colors) }
        let callKey = state.Key(c.module, index)
        if (callee.kind == "name" || imported) && c.calls.has(callKey) {
            let call = checked.calls[c.calls[callKey]]
            if len(call.arguments) > 0 {
                state.Token(80, "::", index, checked, &c, &colors)
                state.Token(80, "[", index, checked, &c, &colors)
                for position, argument in call.arguments { if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }; state.Type(argument, index, checked, &c, &colors) }
                state.Token(80, "]", index, checked, &c, &colors)
            }
        }
        state.Token(80, "(", index, checked, &c, &colors)
        for position, argument in slice(children, 1, len(children)) {
            if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            Emit(argument, checked, &c, &colors)
        }
        state.Token(80, ")", index, checked, &c, &colors); return
    }
    if node.kind == "array" || node.kind == "map" || node.kind == "map_inferred" {
        state.Type(state.ExpressionType(index, checked, &c), index, checked, &c, &colors)
        state.Token(80, "(", index, checked, &c, &colors)
        if node.kind == "array" {
            state.Token(80, "[", index, checked, &c, &colors)
            for position, child in children { if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }; Emit(child, checked, &c, &colors) }
            state.Token(80, "]", index, checked, &c, &colors)
        } else {
            state.Token(80, "{", index, checked, &c, &colors)
            var start = 1
            if node.kind == "map_inferred" { start = 0 }
            for position, child in slice(children, start, len(children)) {
                if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
                Emit(nodes[child].children[0], checked, &c, &colors); state.Token(80, ":", index, checked, &c, &colors); Emit(nodes[child].children[1], checked, &c, &colors)
            }
            state.Token(80, "}", index, checked, &c, &colors)
        }
        state.Token(80, ")", index, checked, &c, &colors); return
    }
    if node.kind == "index" { Emit(children[0], checked, &c, &colors); state.Token(80, "[", index, checked, &c, &colors); Emit(children[1], checked, &c, &colors); state.Token(80, "]", index, checked, &c, &colors); return }
    state.Report(index, "Expression pixel emission is not implemented: " + node.kind, checked, &c)
}
