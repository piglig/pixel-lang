import "model.pxl" as model
import "types.pxl" as types
import "frames.pxl" as frames
import "frame_cache.pxl" as frameCache
import "schemas.pxl" as schemas
import "ir_state.pxl" as state
import "ir_expr.pxl" as expression
import "ir_cache.pxl" as cache
import "ir_flow.pxl" as flowIR

fn Statement(index: int, c: inout state.Context, planned: inout model.ClosurePlan) {
    expression.Statement(index, &c, &planned)
}

fn Fields(fields: [model.TypeField], resolved: model.ResolvedTypes) -> map[string, string] {
    var result: map[string, string] = map[string, string]{}
    for field in fields { result[field.name] = state.TypeName(field.typeId, resolved) }
    return result
}
export effect fn Build(planned: inout model.ClosurePlan) -> state.Output {
    var reuse: Option[cache.Reuse] = .None
    return Lower(&reuse, &planned)
}
export effect fn BuildCached(reuse: inout cache.Reuse, planned: inout model.ClosurePlan) -> state.Output {
    var cached: Option[cache.Reuse] = .Some(reuse)
    let output = Lower(&cached, &planned)
    match cached { .Some(current) => { reuse = current }, .None => {} }
    return output
}
fn FrameLayout(reuse: inout Option[cache.Reuse], planned: inout model.ClosurePlan) -> model.FramePlan {
    // Release temporary source and symbol indexes before IR builds its own index.
    var layout = model.FramePlan{functions: [], entry: planned.named.entry, diagnostics: []}
    match reuse {
        .Some(previous) => {
            var current = previous
            var query = frameCache.Begin(current.previous.frames, current.semantic, planned)
            layout = frames.BuildCached(&planned, &query)
            current.current.frames = query.current
            current.frameHits = query.hits
            current.plannedFrames = query.checked
            reuse = .Some(current)
        },
        .None => { layout = frames.Build(&planned) }
    }
    return layout
}
effect fn Lower(reuse: inout Option[cache.Reuse], planned: inout model.ClosurePlan) -> state.Output {
    var program: state.Program = state.Program{version: "0.9", coordinateFrames: map[string, string]{}, effectFunctions: [], flows: map[string, state.FlowDefinition]{}, records: map[string, map[string, string]]{}, enums: map[string, map[string, map[string, string]]]{}, entry: [], functions: map[string, state.Function]{}}
    let layout = FrameLayout(&reuse, &planned)
    var diagnostics = layout.diagnostics
    if len(diagnostics) > 0 { return state.Output{ir: program, diagnostics} }

    for definition in planned.named.checked.resolved.definitions {
        let typ = planned.named.checked.resolved.types[definition.typeId]
        if typ.kind == "frame" {
            let nodes = planned.named.checked.resolved.bound.project.modules[typ.module].syntax.nodes
            program.coordinateFrames[state.TypeName(definition.typeId, planned.named.checked.resolved)] = nodes[nodes[typ.declaration].children[0]].text
        }
    }
    let nominal = schemas.Build(&planned)
    for diagnostic in nominal.diagnostics { diagnostics.append(diagnostic) }
    if len(diagnostics) > 0 { return state.Output{ir: program, diagnostics} }
    program.records["Error"] = Fields(types.FieldTypes(types.ErrorType(&planned.named.checked.resolved), &planned.named.checked.resolved), planned.named.checked.resolved)
    for schema in nominal.schemas {
        let typ = planned.named.checked.resolved.types[schema.typeId]
        let name = state.TypeName(schema.typeId, planned.named.checked.resolved)
        if typ.kind == "record" { program.records[name] = Fields(schema.fields, planned.named.checked.resolved) }
        else {
            var variants: map[string, map[string, string]] = map[string, map[string, string]]{}
            for variant in schema.variants { variants[variant.name] = Fields(variant.fields, planned.named.checked.resolved) }
            program.enums[name] = variants
        }
    }
    program.entry.append(string(layout.entry))
    var expressionTypes: map[string, int] = map[string, int]{}
    var targets: map[string, int] = map[string, int]{}
    var callTypes: map[string, int] = map[string, int]{}
    for edge in planned.named.edges { targets[state.Key(edge.caller, edge.node)] = edge.target }
    for call in planned.named.checked.calls { callTypes[state.Key(call.module, call.node)] = call.functionType }
    var references: map[string, int] = map[string, int]{}
    var declarations: map[string, int] = map[string, int]{}
    for item in planned.named.checked.expressions { expressionTypes[state.Key(item.module, item.node)] = item.typeId }
    for item in planned.named.checked.resolved.bound.references { references[state.Key(item.module, item.node)] = item.symbol }
    for index, item in planned.named.checked.resolved.bound.symbols { if item.module >= 0 { declarations[state.Key(item.module, item.node)] = index } }
    var flowPlans: map[string, model.TypedFlow] = map[string, model.TypedFlow]{}
    for plan in planned.named.checked.flows { flowPlans[state.Key(plan.module, plan.graph.declaration)] = plan }
    var spans: map[string, state.Span] = map[string, state.Span]{}
    var signatureParameters: map[string, [int]] = map[string, [int]]{}
    for signature in planned.named.checked.resolved.signatures {
        signatureParameters[state.Key(signature.module, signature.node)] = signature.parameters
    }
    match reuse { .Some(value) => { var current = value; cache.Prepare(layout, planned, &current); reuse = .Some(current) }, .None => {} }
    for id, frame in layout.functions {
        let owner = planned.named.checked.resolved.bound.symbols[planned.named.instances[frame.owner].symbol]
        if planned.named.checked.resolved.types[frame.typeId].name == "effect" { program.effectFunctions.append(string(id)) }
        let instance = planned.named.instances[frame.owner]
        let source = planned.named.checked.resolved.bound.symbols[instance.symbol]
        let parameters = signatureParameters[state.Key(source.module, source.node)]
        var c: state.Context = state.Context{frames: layout, frame, code: [], diagnostics: [], expressionTypes, targets, callTypes, references, declarations, parameters: parameters, arguments: instance.arguments, spans, labels: 0, breaks: [], continues: [], loopStacks: [], locals: len(frame.slots)}
        if owner.kind == "flow" && frame.closure < 0 {
            let key = state.Key(frame.module, frame.node)
            if !flowPlans.has(key) { state.Report(frame.node, "Missing checked flow plan", planned, &c); diagnostics.extend(c.diagnostics); spans = c.spans; continue }
            let plan = flowPlans[key]
            var reusedFlow = false
            match reuse {
                .Some(value) => {
                    var current = value
                    match cache.TakeFlow(id, frame.module, &current) {
                        .Some(bundle) => {
                            program.flows[string(id)] = bundle.graph
                            for name, function in bundle.functions { program.functions[name] = function }
                            reusedFlow = true
                        },
                        .None => {}
                    }
                    reuse = .Some(current)
                },
                .None => {}
            }
            if reusedFlow { continue }
            match flowIR.Lower(plan, id, &program.functions, &c, &planned) {
                .Some(loweredFlow) => { program.flows[string(id)] = loweredFlow }
                .None => { diagnostics.extend(c.diagnostics); spans = c.spans; break }
            }
        }
        var reused = false
        // Flow lowering already emitted both instructions and matching graph
        // metadata. Reusing only its instruction body would split those identities.
        if owner.kind != "flow" || frame.closure >= 0 {
        match reuse {
            .Some(value) => {
                var current = value
                match cache.Take(id, planned.named.checked.resolved.bound.project.modules[frame.module].path, &current) {
                    .Some(function) => { program.functions[string(id)] = function; cache.Store(id, function, &current); reused = true }
                    .None => {}
                }
                reuse = .Some(current)
            }
            .None => {}
        }
        }
        if reused { diagnostics.extend(c.diagnostics); spans = c.spans; continue }
        let functionNode = planned.named.checked.resolved.bound.project.modules[frame.module].syntax.nodes[frame.node]
        if owner.kind != "flow" || frame.closure >= 0 { Statement(functionNode.children[len(functionNode.children) - 1], &c, &planned) }
        let signature = planned.named.checked.resolved.types[frame.typeId]
        let result = state.TypeName(signature.arguments[len(signature.arguments) - 1], planned.named.checked.resolved)
        if owner.kind != "flow" || frame.closure >= 0 {
            if result == "unit" { state.Unit(frame.node, planned, &c); state.Op("RETURN", frame.node, planned, &c) }
            else { state.Emit("TRAP", jsonFrom("Function reached end without return"), frame.node, planned, &c) }
        }
        var params: [string] = []
        var captures: [string] = []
        for slot in frame.slots {
            if slot.kind == "parameter" { params.append(state.TypeName(signature.arguments[len(params)], planned.named.checked.resolved)) }
            if slot.kind == "capture" { captures.append(state.TypeName(slot.typeId, planned.named.checked.resolved)) }
        }
        program.functions[string(id)] = state.Function{params: params, captures: captures, locals: c.locals, result, instructions: c.code}
        if owner.kind != "flow" || frame.closure >= 0 {
            match reuse { .Some(value) => { var current = value; cache.Store(id, program.functions[string(id)], &current); reuse = .Some(current) }, .None => {} }
        } else {
            match reuse { .Some(value) => { var current = value; cache.StoreFlow(id, program.flows[string(id)], program.functions, &current); reuse = .Some(current) }, .None => {} }
        }
        diagnostics.extend(c.diagnostics)
        spans = c.spans
    }
    if len(diagnostics) > 0 { program.functions = map[string, state.Function]{}; program.flows = map[string, state.FlowDefinition]{}; program.entry = [] }
    return state.Output{ir: program, diagnostics}
}
