import "model.pxl" as model
import "pixel_decode.pxl" as decode
import "pixel_statements.pxl" as statements
import "spatial_layout.pxl" as layout
record Chunk { kind: string, items: [json] }
record End { kind: string, first: int, second: int }
record ParsedHeader { kind: string, roots: [int], entries: [int], diagnostics: [decode.Diagnostic], syntaxDiagnostics: [model.Diagnostic] }
record ParseInput { links: [layout.PixelLink], tokenFiles: [string] }
record ParsedInput { roots: [int], entries: [int], diagnostics: [decode.Diagnostic], syntaxDiagnostics: [model.Diagnostic], tokenFiles: [string], nodeFiles: [string] }
effect fn Emit[T](kind: string, values: [T], encode: fn(T) -> json) {
    var chunk: [json] = []
    var size = 0
    for value in values {
        let encoded = encode(value)
        let length = len(jsonStringify(encoded))
        if len(chunk) > 0 && (size + length > 128000 || len(chunk) >= 1000) {
            print(jsonStringify(jsonFrom(Chunk{kind, items: chunk})))
            chunk = []; size = 0
        }
        chunk.append(encoded); size += length + 1
    }
    if len(chunk) > 0 { print(jsonStringify(jsonFrom(Chunk{kind, items: chunk}))) }
}
export effect fn Finish(kind: string, first: int, second: int) { print(jsonStringify(jsonFrom(End{kind, first, second}))) }
export effect fn EmitParsed(parsed: statements.Output) {
    print(jsonStringify(jsonFrom(ParsedHeader{kind: "parsed", roots: parsed.syntax.roots, entries: parsed.entries, diagnostics: parsed.diagnostics, syntaxDiagnostics: parsed.syntax.diagnostics})))
    Emit("tokens", parsed.syntax.tokens, fn(value: model.Token) -> json = jsonFrom(value))
    Emit("nodes", parsed.syntax.nodes, fn(value: model.Node) -> json = jsonFrom(value))
    Finish("parsed-end", len(parsed.syntax.tokens), len(parsed.syntax.nodes))
}
export record Input { links: [layout.PixelLink], decoded: decode.Output }
export effect fn LoadSource(path: string) -> Result[Input, Error] {
    let header = jsonDecode::[ParseInput](readText(path)?)?
    var tokens: [decode.Token] = []
    for file in header.tokenFiles { tokens.extend(jsonDecode::[[decode.Token]](readText(file)?)?) }
    return .Ok(Input{links: header.links, decoded: decode.Output{tokens, diagnostics: []}})
}
export effect fn LoadParsed(path: string) -> Result[statements.Output, Error] {
    let header = jsonDecode::[ParsedInput](readText(path)?)?
    var tokens: [model.Token] = []
    var nodes: [model.Node] = []
    for file in header.tokenFiles { tokens.extend(jsonDecode::[[model.Token]](readText(file)?)?) }
    for file in header.nodeFiles { nodes.extend(jsonDecode::[[model.Node]](readText(file)?)?) }
    return .Ok(statements.Output{syntax: model.Parsed{tokens, nodes, roots: header.roots, diagnostics: header.syntaxDiagnostics}, entries: header.entries, diagnostics: header.diagnostics})
}

export effect fn Pixels(values: [layout.Pixel]) { Emit("pixels", values, fn(value: layout.Pixel) -> json = jsonFrom(value)) }
export effect fn Decoded(values: [decode.Token]) { Emit("decoded", values, fn(value: decode.Token) -> json = jsonFrom(value)) }
