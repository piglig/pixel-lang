import "model.pxl" as model
import "pixel_decode.pxl" as decoder
import "pixel_regions.pxl" as regions
import "pixel_reader.pxl" as reader
import "pixel_types.pxl" as types
import "pixel_expressions.pxl" as expressions
import "pixel_restore.pxl" as restore

export record Output { syntax: model.Parsed, entries: [int], diagnostics: [decoder.Diagnostic] }
record Context { r: reader.Reader, regions: [regions.Region], children: map[string, [int]], entries: [int] }
fn Begin(region: int, c: inout Context) -> int {
    let start = len(c.r.tokens)
    c.r.regionTokens = c.regions[region].tokens
    c.r.regionStart = start
    for token in c.regions[region].tokens { c.r.tokens.append(token) }
    c.r.index = start; return start
}
fn End(c: inout Context) { if c.r.index != len(c.r.tokens) { reader.Problem("Unexpected token after statement header", &c.r) } }
fn Head(c: Context, region: int, name: string) -> bool {
    let token = c.regions[region].tokens[0]
    return token.kind == "keyword" && regions.Named(token, name)
}
fn Children(c: Context, region: int) -> [int] {
    if c.children.has(string(region)) { return c.children[string(region)] }
    return []
}
fn Body(region: int, depth: int, c: inout Context) -> int {
    let start = c.r.index
    let children = Block(region, depth + 1, &c)
    return reader.Add("block", "", children, start, &c.r)
}
fn Generics(r: inout reader.Reader) -> [int] {
    var result: [int] = []
    if reader.Take("punct", "[", &r) {
        while len(r.diagnostics) == 0 {
            let start = r.index
            let name = reader.Name(reader.Identity(&r))
            var constraints: [int] = []
            if reader.Take("punct", ":", &r) {
                let at = r.index
                var capability = "Equatable"
                if reader.Take("type", "Ordered", &r) { capability = "Ordered" }
                else if reader.Take("type", "Numeric", &r) { capability = "Numeric" }
                else if reader.Take("type", "Hashable", &r) { capability = "Hashable" }
                else { reader.Need("type", "Equatable", &r) }
                constraints.append(reader.Add("type_constraint", capability, [], at, &r))
            }
            result.append(reader.Add("type_parameter", name, constraints, start, &r))
            if !reader.Take("punct", ",", &r) { break }
        }
        reader.Need("punct", "]", &r)
    }
    return result
}
fn FieldName(r: inout reader.Reader) -> string {
    let literal = reader.Literal(r)
    if len(literal.diagnostics) > 0 || literal.kind != "str" { reader.Problem("Field requires a UTF-8 name", &r); return "" }
    r.index = literal.next; return reader.String(literal.value, &r)
}
fn FlowParent(c: Context, region: int) -> bool {
    let parent = c.regions[region].parent
    if parent < 0 { return false }
    let tokens = c.regions[parent].tokens
    var index = 0
    if tokens[0].kind == "keyword" && regions.Named(tokens[0], "export") { index += 1 }
    return index < len(tokens) && tokens[index].kind == "keyword" && regions.Named(tokens[index], "flow")
}
fn Parameters(r: inout reader.Reader, children: inout [int]) -> int {
    reader.Need("punct", "(", &r)
    var count = 0
    if !reader.At(r, "punct", ")") {
        while len(r.diagnostics) == 0 {
            let at = r.index
            let parameter = reader.Name(reader.Identity(&r)); reader.Need("punct", ":", &r)
            let typ = types.Parameter(&r)
            children.append(reader.Add("parameter", parameter, [typ], at, &r)); count += 1
            if !reader.Take("punct", ",", &r) { break }
        }
    }
    reader.Need("punct", ")", &r)
    return count
}
fn Statement(region: int, depth: int, c: inout Context) -> int {
    let start = Begin(region, &c)
    let exported = reader.Take("keyword", "export", &c.r)
    let entry = reader.Take("keyword", "entry", &c.r)
    if c.r.index >= len(c.r.tokens) || c.r.tokens[c.r.index].kind != "keyword" {
        reader.Problem("Expected statement keyword", &c.r); return reader.Add("invalid", "", [], start, &c.r)
    }
    let kind = reader.String(c.r.tokens[c.r.index].value, &c.r); c.r.index += 1
    if exported && kind != "fn" && kind != "effect_fn" && kind != "flow" && kind != "frame" && kind != "record" && kind != "enum" { reader.Problem("Only declarations may be exported", &c.r) }
    if entry && kind != "fn" && kind != "effect_fn" { reader.Problem("Entry marker requires a function", &c.r) }
    var result = -1
    var opens = false
    if kind == "value_body" {
        if c.regions[region].parent >= 0 { reader.Problem("Value body must be a separate root region", &c.r) }
        let name = reader.Name(reader.Identity(&c.r))
        End(&c)
        let children = Block(region, depth + 1, &c)
        for position, child in children {
            if c.r.nodes[child].kind == "block_result" && position + 1 != len(children) {
                reader.Problem("Value block result must be the final statement", &c.r)
            }
        }
        result = reader.Add("value_body", name, children, start, &c.r); opens = true
    } else if kind == "block_result" {
        let parent = c.regions[region].parent
        if parent < 0 || !Head(c, parent, "value_body") { reader.Problem("Block result requires a value body parent", &c.r) }
        result = reader.Add("block_result", "", [expressions.Parse(&c.r)], start, &c.r)
    } else if kind == "fn" || kind == "effect_fn" || kind == "flow" || (kind == "lambda_body" || kind == "effect_body") {
        let name = reader.Name(reader.Identity(&c.r))
        var children = Generics(&c.r)
        if kind == "flow" && len(children) > 0 { reader.Problem("Flow cannot declare type parameters", &c.r) }
        if (kind == "lambda_body" || kind == "effect_body") && len(children) > 0 { reader.Problem("Lambda body cannot declare type parameters", &c.r) }
        var parameters = Parameters(&c.r, &children)
        if kind == "flow" {
            for child in children { if c.r.nodes[child].kind == "parameter" { reader.SetKind(child, "initial_parameter", &c.r) } }
            reader.Need("keyword", "step", &c.r)
            parameters = Parameters(&c.r, &children)
        }
        reader.Need("punct", "->", &c.r)
        let at = c.r.index
        let typ = types.Parse(&c.r)
        if entry && (parameters > 0 || len(children) > 0 || c.r.nodes[typ].kind != "type" || c.r.nodes[typ].text != "unit") { reader.Problem("Entry must be nongeneric, parameterless and return unit", &c.r) }
        if kind == "effect_fn" { children.append(reader.Add("effect_marker", "", [], start, &c.r)) }
        children.append(reader.Add("result", "", [typ], at, &c.r))
        End(&c)
        let body = Body(region, depth, &c)
        if kind == "flow" {
            reader.SetKind(body, "flow_body", &c.r)
            for member in c.r.nodes[body].children {
                let item = c.r.nodes[member].kind
                if item != "flow_value" && item != "flow_state" && item != "flow_instance" && item != "flow_next" && item != "flow_output" { reader.Problem("Flow body requires expression flow members", &c.r) }
            }
        }
        children.append(body); opens = true
        var declarationKind = kind
        if kind == "effect_fn" { declarationKind = "fn" }
        result = reader.Add(declarationKind, name, children, start, &c.r)
        if entry { c.entries.append(result) }
    } else if kind == "state" || kind == "instance" || kind == "next" || kind == "output" {
        if !FlowParent(c, region) { reader.Problem("Flow member requires a flow parent", &c.r) }
        if kind == "state" {
            let name = reader.Name(reader.Identity(&c.r))
            var children: [int] = []
            if reader.Take("punct", ":", &c.r) { children.append(reader.Add("annotation", "", [types.Parse(&c.r)], start, &c.r)) }
            reader.Need("punct", "=", &c.r); children.append(expressions.Parse(&c.r))
            result = reader.Add("flow_state", name, children, start, &c.r)
        } else if kind == "instance" || kind == "next" {
            let name = reader.Name(reader.Identity(&c.r)); reader.Need("punct", "=", &c.r)
            var memberKind = "flow_instance"
            if kind == "next" { memberKind = "flow_next" }
            result = reader.Add(memberKind, name, [expressions.Parse(&c.r)], start, &c.r)
        } else { result = reader.Add("flow_output", "", [expressions.Parse(&c.r)], start, &c.r) }
    } else if kind == "frame" {
        let name = reader.Name(reader.Identity(&c.r)); reader.Need("punct", "=", &c.r)
        let at = c.r.index
        let unit = FieldName(&c.r)
        let child = reader.Add("frame_unit", unit, [], at, &c.r)
        result = reader.Add("frame", name, [child], start, &c.r)
    } else if kind == "record" || kind == "enum" {
        let name = reader.Name(reader.Identity(&c.r))
        var children = Generics(&c.r)
        reader.Need("punct", "(", &c.r)
        if !reader.At(c.r, "punct", ")") {
            while len(c.r.diagnostics) == 0 {
                let at = c.r.index
                let field = FieldName(&c.r)
                if kind == "record" {
                    reader.Need("punct", ":", &c.r)
                    children.append(reader.Add("field_decl", field, [types.Parse(&c.r)], at, &c.r))
                } else {
                    var fields: [int] = []
                    reader.Need("punct", "(", &c.r)
                    if !reader.At(c.r, "punct", ")") {
                        while len(c.r.diagnostics) == 0 {
                            let fieldStart = c.r.index
                            let fieldName = FieldName(&c.r); reader.Need("punct", ":", &c.r)
                            fields.append(reader.Add("parameter", fieldName, [types.Parse(&c.r)], fieldStart, &c.r))
                            if !reader.Take("punct", ",", &c.r) { break }
                        }
                    }
                    reader.Need("punct", ")", &c.r)
                    children.append(reader.Add("variant_decl", field, fields, at, &c.r))
                }
                if !reader.Take("punct", ",", &c.r) { break }
            }
        }
        reader.Need("punct", ")", &c.r)
        result = reader.Add(kind, name, children, start, &c.r)
    } else if kind == "import" {
        let id = reader.Identity(&c.r)
        let alias = reader.Add("alias", "_module_" + string(id), [], start, &c.r)
        result = reader.Add("import", "_module_" + string(id) + ".pxl", [alias], start, &c.r)
    } else if kind == "let" || kind == "var" {
        let name = reader.Name(reader.Identity(&c.r))
        var children: [int] = []
        if reader.Take("punct", ":", &c.r) { children.append(reader.Add("annotation", "", [types.Parse(&c.r)], start, &c.r)) }
        reader.Need("punct", "=", &c.r); children.append(expressions.Parse(&c.r))
        var bindingKind = kind
        if FlowParent(c, region) {
            if kind != "let" { reader.Problem("Flow computations must use let", &c.r) }
            bindingKind = "flow_value"
        }
        result = reader.Add(bindingKind, name, children, start, &c.r)
    } else if kind == "set" {
        let left = expressions.Parse(&c.r)
        var op = ""
        for candidate in ["=", "+=", "-=", "*=", "/=", "%="] { if reader.Take("punct", candidate, &c.r) { op = candidate; break } }
        if op == "" { reader.Problem("Expected assignment operator", &c.r) }
        let right = expressions.Parse(&c.r)
        result = reader.Add("assign", op, [left, right], start, &c.r)
    } else if kind == "if" || kind == "while" || kind == "for" || kind == "match" {
        var children: [int] = []
        if kind == "for" {
            let at = c.r.index
            children.append(reader.Add("binding", reader.Name(reader.Identity(&c.r)), [], at, &c.r))
            if reader.Take("punct", ",", &c.r) { let second = c.r.index; children.append(reader.Add("binding", reader.Name(reader.Identity(&c.r)), [], second, &c.r)) }
            reader.Need("keyword", "in", &c.r)
        }
        if kind == "match" { children.append(expressions.Subjects(depth, &c.r)) }
        else { children.append(expressions.Parse(&c.r)) }
        End(&c)
        if kind == "match" {
            for caseRegion in Children(c, region) {
                let at = Begin(caseRegion, &c)
                reader.Need("keyword", "case", &c.r)
                var arm = expressions.Patterns(depth, &c.r); End(&c)
                arm.append(Body(caseRegion, depth, &c))
                children.append(reader.Add("arm", "", arm, at, &c.r))
            }
            result = reader.Add("match_stmt", "", children, start, &c.r)
        } else { children.append(Body(region, depth, &c)); result = reader.Add(kind, "", children, start, &c.r) }
        opens = true
    } else if kind == "print" || kind == "do" {
        let value = expressions.Parse(&c.r)
        var expression = value
        if kind == "print" { let callee = reader.Add("name", "print", [], start, &c.r); expression = reader.Add("call", "", [callee, value], start, &c.r) }
        result = reader.Add("expression_stmt", "", [expression], start, &c.r)
    } else if kind == "return" {
        var children: [int] = []
        if c.r.index < len(c.r.tokens) { children.append(expressions.Parse(&c.r)) }
        result = reader.Add("return", "", children, start, &c.r)
    } else if kind == "break" || kind == "continue" { result = reader.Add(kind, "", [], start, &c.r) }
    else { reader.Problem("Unsupported or orphan statement: " + kind, &c.r); result = reader.Add("invalid", "", [], start, &c.r) }
    End(&c)
    if !opens && len(Children(c, region)) > 0 { reader.Problem("Statement cannot contain child regions", &c.r) }
    if exported { result = reader.Add("export", "", [result], start, &c.r) }
    return result
}
fn Block(parent: int, depth: int, c: inout Context) -> [int] {
    if depth > 128 { reader.Problem("Statement nesting exceeds 128", &c.r); return [] }
    var result: [int] = []
    let rows = Children(c, parent)
    var index = 0
    while index < len(rows) && len(c.r.diagnostics) == 0 {
        let node = Statement(rows[index], depth, &c)
        index += 1
        let statement = c.r.nodes[node]
        if statement.kind == "if" && index < len(rows) && Head(c, rows[index], "else") {
            Begin(rows[index], &c); reader.Need("keyword", "else", &c.r); End(&c)
            reader.Attach(node, Body(rows[index], depth, &c), statement.text, &c.r); index += 1
        }
        result.append(node)
    }
    return result
}
export fn Parse(analyzed: regions.Output, source: string, module: int) -> Output {
    var c: Context = Context{r: reader.New(source, module, []), regions: analyzed.regions, children: map[string, [int]]{}, entries: []}
    c.r.diagnostics = analyzed.diagnostics
    for region in analyzed.regions {
        let key = string(region.parent)
        if !c.children.has(key) { c.children[key] = [] }
        c.children[key].append(region.id)
    }
    let roots = Block(-1, 0, &c)
    var tokens: [model.Token] = []
    for index, token in c.r.tokens { tokens.append(model.Token{kind: "pixel", text: "", value: "", start: index, end: index + 1, line: token.position[1] + 1, column: token.position[0] + 1}) }
    let finalRoots = roots
    var syntax = model.Parsed{tokens: tokens, nodes: c.r.nodes, roots: finalRoots, diagnostics: []}
    if len(c.r.diagnostics) > 0 { syntax = model.Parsed{tokens: syntax.tokens, nodes: syntax.nodes, roots: [], diagnostics: []}; c.entries = [] }
    if len(c.r.diagnostics) > 0 { return Output{syntax, entries: c.entries, diagnostics: c.r.diagnostics} }
    let restored = restore.Build(syntax, c.entries, source)
    return Output{syntax: restored.syntax, entries: restored.entries, diagnostics: restored.diagnostics}
}
