import "pixel_reader.pxl" as reader
import "pixel_decode.pxl" as decoder
import "pixel_types.pxl" as types

fn Precedence(op: string) -> int {
    if op == "or" { return 1 }
    if op == "and" { return 2 }
    if op == "==" || op == "!=" { return 3 }
    if op == "<" || op == "<=" || op == ">" || op == ">=" { return 4 }
    if op == "+" || op == "-" { return 5 }
    if op == "*" || op == "/" || op == "%" { return 6 }
    return 0
}
fn Text(op: string) -> string {
    if op == "and" { return "&&" }
    if op == "or" { return "||" }
    if op == "not" { return "!" }
    return op
}
export fn Parse(r: inout reader.Reader) -> int = Expression(1, 0, &r)
fn Array(depth: int, start: int, r: inout reader.Reader) -> int {
    reader.Need("punct", "[", &r)
    var items: [int] = []
    if !reader.At(r, "punct", "]") {
        while len(r.diagnostics) == 0 {
            items.append(Expression(1, depth + 1, &r))
            if !reader.Take("punct", ",", &r) { break }
        }
    }
    reader.Need("punct", "]", &r)
    return reader.Add("array", "", items, start, &r)
}
fn TypeTarget(typeId: int, start: int, r: inout reader.Reader) -> int {
    let typ = r.nodes[typeId]
    let parts = split(typ.text, ".")
    var target = reader.Add("name", parts[0], [], start, &r)
    if len(parts) == 2 { target = reader.Add("field", parts[1], [target], start, &r) }
    if len(typ.children) > 0 {
        var arguments: [int] = [target]
        for child in typ.children { arguments.append(child) }
        target = reader.Add("specialize", "", arguments, start, &r)
    }
    return target
}
fn InferredMap(depth: int, start: int, r: inout reader.Reader) -> int {
    var entries: [int] = []
    reader.Need("punct", "{", &r)
    if !reader.At(r, "punct", "}") {
        while len(r.diagnostics) == 0 {
            let at = r.index
            let key = Expression(1, depth + 1, &r); reader.Need("punct", ":", &r)
            let value = Expression(1, depth + 1, &r)
            entries.append(reader.Add("map_entry", "", [key, value], at, &r))
            if !reader.Take("punct", ",", &r) { break }
        }
    }
    reader.Need("punct", "}", &r)
    return reader.Add("map_inferred", "", entries, start, &r)
}
fn Typed(depth: int, start: int, r: inout reader.Reader) -> int {
    let originalType = types.Parse(&r)
    var typeId = originalType
    let typ = r.nodes[typeId]
    reader.Need("punct", "(", &r)
    var value = -1
    if typ.kind == "type_array" {
        value = Array(depth, start, &r)
        value = reader.Add("annotate", "", [value, originalType], start, &r)
    } else if typ.kind == "type" && typ.text == "map" {
        var items: [int] = [typeId]
        reader.Need("punct", "{", &r)
        if !reader.At(r, "punct", "}") {
            while len(r.diagnostics) == 0 {
                let fieldStart = r.index
                let key = Expression(1, depth + 1, &r); reader.Need("punct", ":", &r)
                let item = Expression(1, depth + 1, &r)
                items.append(reader.Add("map_entry", "", [key, item], fieldStart, &r))
                if !reader.Take("punct", ",", &r) { break }
            }
        }
        reader.Need("punct", "}", &r)
        value = reader.Add("map", "", items, start, &r)
    } else if typ.kind == "type" && (typ.text == "Error" || typ.text == "Point3" || typ.text == "Vec3" || typ.text == "Transform3" || (len(typ.text) >= 7 && slice(typ.text, 0, 7) == "_pixel_") || (len(typ.text) >= 8 && slice(typ.text, 0, 8) == "_module_")) {
        var items: [int] = [TypeTarget(typeId, start, &r)]
        reader.Need("punct", "{", &r)
        if !reader.At(r, "punct", "}") {
            while len(r.diagnostics) == 0 {
                let fieldStart = r.index
                let key = reader.Literal(r)
                if key.kind != "str" || len(key.diagnostics) > 0 { reader.Problem("Record constructor requires named fields", &r); break }
                r.index = key.next; reader.Need("punct", ":", &r)
                let item = Expression(1, depth + 1, &r)
                items.append(reader.Add("initializer", reader.String(key.value, &r), [item], fieldStart, &r))
                if !reader.Take("punct", ",", &r) { break }
            }
        }
        reader.Need("punct", "}", &r)
        value = reader.Add("construct", "", items, start, &r)
    } else {
        reader.Problem("Typed expression requires an array, map or record literal", &r)
        value = reader.Add("invalid", "", [], start, &r)
    }
    reader.Need("punct", ")", &r)
    if originalType != typeId && typ.kind != "type_array" { value = reader.Add("annotate", "", [value, originalType], start, &r) }
    return value
}
fn Variant(depth: int, start: int, r: inout reader.Reader) -> int {
    reader.Need("punct", "(", &r)
    let typeId = types.Parse(&r); reader.Need("punct", ",", &r)
    let name = reader.Literal(r)
    if name.kind != "str" || len(name.diagnostics) > 0 {
        reader.Problem("Variant requires a UTF-8 name", &r); return reader.Add("invalid", "", [], start, &r)
    }
    r.index = name.next
    let variant = reader.String(name.value, &r)
    var target = reader.Add("field", variant, [TypeTarget(typeId, start, &r)], start, &r)
    var arguments: [int] = [target]
    while len(r.diagnostics) == 0 && reader.Take("punct", ",", &r) { arguments.append(Expression(1, depth + 1, &r)) }
    reader.Need("punct", ")", &r)
    if len(arguments) > 1 { target = reader.Add("call", "", arguments, start, &r) }
    target = reader.Add("annotate", "", [target, typeId], start, &r)
    return target
}
fn Pattern(depth: int, r: inout reader.Reader) -> int {
    let start = r.index
    if depth > 128 || len(r.diagnostics) > 0 {
        reader.Problem("Pattern nesting exceeds 128", &r)
        return reader.Add("invalid", "", [], start, &r)
    }
    if reader.Take("keyword", "otherwise", &r) { return reader.Add("wildcard_pattern", "", [], start, &r) }
    if r.index < len(r.tokens) && r.tokens[r.index].kind == "id" {
        let id = reader.Identity(&r)
        return reader.Add("binding", reader.Name(id), [], start, &r)
    }
    let typeId = types.Parse(&r)
    var children: [int] = [reader.Add("pattern_qualifier", "", [typeId], start, &r)]
    let name = reader.Literal(r)
    if name.kind != "str" || len(name.diagnostics) > 0 {
        reader.Problem("Pattern requires a UTF-8 variant name", &r); return reader.Add("invalid", "", [], start, &r)
    }
    r.index = name.next
    reader.Need("punct", "(", &r)
    while len(r.diagnostics) == 0 && !reader.At(r, "punct", ")") {
        children.append(Pattern(depth + 1, &r))
        if !reader.Take("punct", ",", &r) { break }
    }
    reader.Need("punct", ")", &r)
    return reader.Add("variant_pattern", reader.String(name.value, &r), children, start, &r)
}
export fn Subjects(depth: int, r: inout reader.Reader) -> int {
    let start = r.index
    reader.Need("punct", "(", &r)
    var children: [int] = [Expression(1, depth + 1, &r)]
    while reader.Take("punct", ",", &r) { children.append(Expression(1, depth + 1, &r)) }
    reader.Need("punct", ")", &r)
    return reader.Add("match_subjects", "", children, start, &r)
}
export fn Patterns(depth: int, r: inout reader.Reader) -> [int] {
    let start = r.index
    reader.Need("punct", "(", &r)
    var patterns: [int] = [Pattern(depth + 1, &r)]
    while reader.Take("punct", ",", &r) { patterns.append(Pattern(depth + 1, &r)) }
    reader.Need("punct", ")", &r)
    var children: [int] = [reader.Add("pattern_list", "", patterns, start, &r)]
    if reader.Take("keyword", "if", &r) {
        let at = r.index
        children.append(reader.Add("pattern_guard", "", [Expression(1, depth + 1, &r)], at, &r))
    }
    return children
}
fn Match(depth: int, start: int, r: inout reader.Reader) -> int {
    var children: [int] = [Subjects(depth, &r)]
    reader.Need("punct", "{", &r)
    while len(r.diagnostics) == 0 && !reader.At(r, "punct", "}") {
        let armStart = r.index
        reader.Need("keyword", "case", &r)
        var arm = Patterns(depth, &r); reader.Need("punct", "=>", &r)
        arm.append(Expression(1, depth + 1, &r))
        children.append(reader.Add("arm", "", arm, armStart, &r))
        if !reader.Take("punct", ",", &r) { break }
    }
    reader.Need("punct", "}", &r)
    return reader.Add("match", "", children, start, &r)
}
fn Expression(minimum: int, depth: int, r: inout reader.Reader) -> int {
    let start = r.index
    if depth > 128 { reader.Problem("Expression nesting exceeds 128", &r) }
    if r.index >= len(r.tokens) { reader.Problem("Expected expression", &r) }
    if len(r.diagnostics) > 0 { return reader.Add("invalid", "", [], start, &r) }
    let token = r.tokens[r.index]
    var left = -1
    if reader.Take("keyword", "value_block", &r) {
        reader.Need("punct", "(", &r)
        let id = reader.Identity(&r); reader.Need("punct", ")", &r)
        left = reader.Add("value_ref", reader.Name(id), [], start, &r)
    } else if reader.Take("keyword", "lambda", &r) {
        reader.Need("punct", "(", &r)
        let id = reader.Identity(&r); reader.Need("punct", ")", &r)
        left = reader.Add("lambda_ref", reader.Name(id), [], start, &r)
    } else if reader.Take("keyword", "variant", &r) {
        left = Variant(depth, start, &r)
    } else if reader.Take("keyword", "match", &r) {
        left = Match(depth, start, &r)
    } else if token.kind == "type" {
        left = Typed(depth, start, &r)
    } else if reader.At(r, "punct", "[") {
        left = Array(depth, start, &r)
    } else if reader.At(r, "punct", "{") {
        left = InferredMap(depth, start, &r)
    } else if reader.Take("punct", "(", &r) {
        left = Expression(1, depth + 1, &r); reader.Need("punct", ")", &r)
    } else if token.kind == "op" && (reader.At(r, "op", "-") || reader.At(r, "op", "not")) {
        r.index += 1
        let operand = Expression(7, depth + 1, &r)
        left = reader.Add("unary", Text(reader.String(token.value, &r)), [operand], start, &r)
    } else if token.kind == "id" {
        let id = reader.Identity(&r)
        if reader.Take("punct", ".", &r) {
            let member = reader.Identity(&r)
            if id == r.module { left = reader.Add("name", reader.Name(member), [], start, &r) }
            else {
                let module = reader.Add("name", "_module_" + string(id), [], start, &r)
                left = reader.Add("field", reader.Name(member), [module], start, &r)
            }
        } else { left = reader.Add("name", reader.Name(id), [], start, &r) }
    } else if token.kind == "builtin" {
        r.index += 1; left = reader.Add("name", reader.String(token.value, &r), [], start, &r)
    } else if token.kind == "int" || token.kind == "bool" || token.kind == "integer_head" || token.kind == "string_head" || token.kind == "float_head" {
        let literal = reader.Literal(r)
        for diagnostic in literal.diagnostics { r.diagnostics.append(diagnostic) }
        if len(r.diagnostics) > 0 { return reader.Add("invalid", "", [], start, &r) }
        r.index = literal.next
        var kind = "literal_" + literal.kind
        var text = jsonStringify(literal.value)
        if literal.kind == "str" { text = reader.String(literal.value, &r) }
        if literal.kind == "bool" { kind = "literal_keyword" }
        if literal.kind == "int" && reader.Integer(literal.value, &r) < 0 {
            let magnitude = reader.Add("literal_int", slice(text, 1, len(text)), [], start, &r)
            left = reader.Add("unary", "-", [magnitude], start, &r)
        } else { left = reader.Add(kind, text, [], start, &r) }
    } else {
        reader.Problem("Unsupported or invalid pixel expression", &r); return reader.Add("invalid", "", [], start, &r)
    }
    while len(r.diagnostics) == 0 && r.index < len(r.tokens) {
        if reader.Take("keyword", "with", &r) {
            var items: [int] = [left]
            reader.Need("punct", "{", &r)
            while !reader.At(r, "punct", "}") && len(r.diagnostics) == 0 {
                let fieldStart = r.index
                let key = reader.Literal(r)
                if key.kind != "str" || len(key.diagnostics) > 0 { reader.Problem("Record update requires named fields", &r); break }
                r.index = key.next
                reader.Need("punct", ":", &r)
                let item = Expression(1, depth + 1, &r)
                items.append(reader.Add("initializer", reader.String(key.value, &r), [item], fieldStart, &r))
                if !reader.Take("punct", ",", &r) { break }
            }
            reader.Need("punct", "}", &r)
            left = reader.Add("record_update", "", items, start, &r); continue
        }
        if reader.Take("punct", "?", &r) { left = reader.Add("propagate", "", [left], start, &r); continue }
        if reader.Take("punct", "(", &r) {
            var arguments: [int] = [left]
            if !reader.At(r, "punct", ")") {
                while len(r.diagnostics) == 0 {
                    let argumentStart = r.index
                    let marked = reader.Take("punct", "&", &r)
                    var argument = Expression(1, depth + 1, &r)
                    if marked {
                        var root = argument
                        while r.nodes[root].kind == "field" || r.nodes[root].kind == "index" { root = r.nodes[root].children[0] }
                        if r.nodes[root].kind != "name" { reader.Problem("inout argument requires a local value address", &r) }
                        argument = reader.Add("inout_argument", "", [argument], argumentStart, &r)
                    }
                    arguments.append(argument)
                    if !reader.Take("punct", ",", &r) { break }
                }
            }
            reader.Need("punct", ")", &r)
            left = reader.Add("call", "", arguments, start, &r); continue
        }
        if reader.Take("punct", "::", &r) {
            reader.Need("punct", "[", &r)
            var arguments: [int] = [left]
            while len(r.diagnostics) == 0 {
                arguments.append(types.Parse(&r))
                if !reader.Take("punct", ",", &r) { break }
            }
            reader.Need("punct", "]", &r)
            left = reader.Add("specialize", "", arguments, start, &r)
            continue
        }
        if reader.Take("punct", "[", &r) {
            let index = Expression(1, depth + 1, &r); reader.Need("punct", "]", &r)
            left = reader.Add("index", "", [left, index], start, &r)
            continue
        }
        if reader.Take("punct", "@", &r) {
            let name = reader.Literal(r)
            if name.kind != "str" || len(name.diagnostics) > 0 { reader.Problem("Field name requires UTF-8 string pixels", &r); return left }
            r.index = name.next
            left = reader.Add("field", reader.String(name.value, &r), [left], start, &r); continue
        }
        let next = r.tokens[r.index]
        if next.kind != "op" { break }
        let op = reader.String(next.value, &r)
        let precedence = Precedence(op)
        if precedence < minimum { break }
        r.index += 1
        let right = Expression(precedence + 1, depth + 1, &r)
        left = reader.Add("binary", Text(op), [left, right], start, &r)
    }
    return left
}
