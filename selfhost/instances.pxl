import "model.pxl" as model
import "types.pxl" as types
import "syntax_index.pxl" as syntaxIndex

record Planner { signatures: map[string, int], interned: map[string, int], instances: [model.FunctionInstance], edges: [model.InstanceEdge], edgeKeys: map[string, bool], diagnostics: [model.Diagnostic], genericCount: int }
fn NodeKey(module: int, node: int) -> string = string(module) + ":" + string(node)
fn Report(module: int, index: int, message: string, checked: model.ExpressionCheck, p: inout Planner) {
    let source = checked.resolved.bound.project.modules[module]
    var start = 0
    var end = 0
    var line = 1
    var column = 1
    if index >= 0 {
        let node = source.syntax.nodes[index]
        start = node.start; end = node.end
        for token in source.syntax.tokens { if token.start >= start { line = token.line; column = token.column; break } }
    }
    p.diagnostics.append(model.Diagnostic{source: source.path, phase: "instantiate", message, start, end, line, column})
}
fn Concrete(typeId: int, depth: int, checked: model.ExpressionCheck) -> bool = types.Concrete(typeId, depth, checked.resolved)
fn Signature(p: Planner, symbol: int, checked: model.ExpressionCheck) -> model.FunctionSignature {
    let target = checked.resolved.bound.symbols[symbol]
    return checked.resolved.signatures[p.signatures[NodeKey(target.module, target.node)]]
}
fn Add(symbol: int, arguments: [int], module: int, node: int, p: inout Planner, checked: inout model.ExpressionCheck) -> int {
    let signature = Signature(p, symbol, checked)
    if len(signature.parameters) != len(arguments) { Report(module, node, "Generic instance arity mismatch", checked, &p); return -1 }
    var key = string(symbol)
    for argument in arguments {
        if !Concrete(argument, 0, checked) { Report(module, node, "Instance type is unresolved or exceeds depth 32", checked, &p); return -1 }
        key += ":" + string(argument)
    }
    if p.interned.has(key) { return p.interned[key] }
    if len(arguments) > 0 && p.genericCount >= 256 { Report(module, node, "Generic function instances exceed 256", checked, &p); return -1 }
    let typeId = types.Substitute(signature.typeId, signature.parameters, arguments, &checked.resolved)
    if !Concrete(typeId, 0, checked) { Report(module, node, "Function signature is not concrete or exceeds depth 32", checked, &p); return -1 }
    let index = len(p.instances)
    p.instances.append(model.FunctionInstance{symbol, arguments: slice(arguments, 0, len(arguments)), typeId})
    p.interned[key] = index
    if len(arguments) > 0 { p.genericCount += 1 }
    return index
}
fn Index(owners: [int], module: int, node: int, item: int, index: inout map[string, [int]]) {
    var owner = owners[node]
    // A named function also retains dependencies inside its nested functions,
    // matching the previous containment rule. Lambdas inherit the named owner.
    while owner >= 0 {
        let key = NodeKey(module, owner)
        if !index.has(key) { index[key] = [] }
        index[key].append(item)
        owner = owners[owner]
    }
}
fn Edge(caller: int, node: int, target: int, kind: string, p: inout Planner) {
    if target < 0 { return }
    let key = string(caller) + ":" + string(node) + ":" + string(target) + ":" + kind
    if p.edgeKeys.has(key) { return }
    p.edgeKeys[key] = true
    p.edges.append(model.InstanceEdge{caller, node, target, kind})
}
export fn Build(checked: model.ExpressionCheck) -> model.InstancePlan {
    return BuildEntry(checked.resolved.bound.project.entryName, checked)
}
export fn BuildEntry(entryName: string, inputChecked: model.ExpressionCheck) -> model.InstancePlan {
    var checked = inputChecked
    var p: Planner = Planner{signatures: map[string, int]{}, interned: map[string, int]{}, instances: [], edges: [], edgeKeys: map[string, bool]{}, diagnostics: [], genericCount: 0}
    if len(checked.diagnostics) > 0 { return model.InstancePlan{checked, instances: [], edges: [], entry: -1, diagnostics: checked.diagnostics} }
    let project = checked.resolved.bound.project
    if len(project.modules) == 0 { return model.InstancePlan{checked, instances: [], edges: [], entry: -1, diagnostics: [model.Diagnostic{source: "<entry>", phase: "instantiate", message: "Entry module is missing", start: 0, end: 0, line: 1, column: 1}]} }
    for index, signature in checked.resolved.signatures { p.signatures[NodeKey(signature.module, signature.node)] = index }
    let entryModule = len(project.modules) - 1
    var entrySymbol = -1
    for index, symbol in checked.resolved.bound.symbols {
        if symbol.module == entryModule && symbol.kind == "fn" && symbol.name == entryName && checked.resolved.bound.scopes[symbol.scope].owner == -1 { entrySymbol = index; break }
    }
    var entry = -1
    if entrySymbol < 0 { Report(entryModule, -1, "Entry module must define " + entryName, checked, &p) }
    else {
        let signature = Signature(p, entrySymbol, checked)
        let typ = checked.resolved.types[signature.typeId]
        if len(signature.parameters) != 0 || typ.kind != "function" || len(typ.arguments) != 1 || typ.arguments[len(typ.arguments) - 1] != types.Scalar("unit", &checked.resolved) {
            Report(entryModule, checked.resolved.bound.symbols[entrySymbol].node, entryName + " must be non-generic, parameterless and return unit", checked, &p)
        } else { entry = Add(entrySymbol, [], entryModule, checked.resolved.bound.symbols[entrySymbol].node, &p, &checked) }
    }
    var owners: [[int]] = []
    for module in project.modules { owners.append(syntaxIndex.Owners(module.syntax)) }
    var calls: map[string, [int]] = map[string, [int]]{}
    var references: map[string, [int]] = map[string, [int]]{}
    for signature in checked.resolved.signatures {
        let key = NodeKey(signature.module, signature.node)
        calls[key] = []; references[key] = []
    }
    for index, call in checked.calls {
        Index(owners[call.module], call.module, call.node, index, &calls)
    }
    for index, reference in checked.resolved.bound.references { Index(owners[reference.module], reference.module, reference.node, index, &references) }
    var cursor = 0
    while cursor < len(p.instances) && len(p.diagnostics) == 0 {
        let instance = p.instances[cursor]
        let owner = checked.resolved.bound.symbols[instance.symbol]
        let signature = Signature(p, instance.symbol, checked)
        let ownerKey = NodeKey(owner.module, owner.node)
        if owner.kind == "flow" {
            for flow in checked.flows {
                if flow.module != owner.module || flow.graph.declaration != owner.node { continue }
                for node in flow.instances { Edge(cursor, node.node, Add(node.symbol, [], owner.module, node.node, &p, &checked), "flow-node", &p) }
            }
        }
        for callIndex in calls[ownerKey] {
            let call = checked.calls[callIndex]
            if call.symbol < 0 { continue }
            let target = checked.resolved.bound.symbols[call.symbol]
            if !model.CallableDeclaration(target.kind) { continue }
            var arguments: [int] = []
            for argument in call.arguments { arguments.append(types.Substitute(argument, signature.parameters, instance.arguments, &checked.resolved)) }
            let resolved = Add(call.symbol, arguments, call.module, call.node, &p, &checked)
            Edge(cursor, call.node, resolved, call.kind, &p)
        }
        for referenceIndex in references[ownerKey] {
            let reference = checked.resolved.bound.references[referenceIndex]
            let target = checked.resolved.bound.symbols[reference.symbol]
            if !model.CallableDeclaration(target.kind) { continue }
            if len(Signature(p, reference.symbol, checked).parameters) > 0 { continue }
            let resolved = Add(reference.symbol, [], reference.module, reference.node, &p, &checked)
            Edge(cursor, reference.node, resolved, "reference", &p)
        }
        cursor += 1
    }
    return model.InstancePlan{checked, instances: p.instances, edges: p.edges, entry, diagnostics: p.diagnostics}
}
