import "model.pxl" as model

export record Lookup { module: string, name: string, expected: string }
export record Entry { shape: [model.Node], nodes: [int], firstScope: int, firstSymbol: int, scopes: [model.Scope], symbols: [model.Symbol], references: [model.Reference], captures: [model.Capture], external: map[string, string], lookups: [Lookup] }
export record Snapshot { entries: map[string, Entry] }
export record Reuse { previous: Snapshot, current: Snapshot, hits: int, checked: int }
export fn Empty() -> Snapshot = Snapshot{entries: map[string, Entry]{}}
export fn Begin(previous: Snapshot) -> Reuse = Reuse{previous, current: Empty(), hits: 0, checked: 0}
record Binder { lookupSeen: map[string, bool], tracking: bool, lookups: [Lookup], modules: map[string, int], globals: map[string, int], project: model.Project, scopes: [model.Scope], names: [map[string, int]], symbols: [model.Symbol], references: [model.Reference], captures: [model.Capture], diagnostics: [model.Diagnostic], moduleScopes: [int] }
fn Scope(b: inout Binder, parent: int, owner: int, module: int, node: int) -> int {
    let index = len(b.scopes)
    b.scopes.append(model.Scope{parent, owner, module, node, symbols: map[string, int]{}})
    let names: map[string, int] = map[string, int]{}
    b.names.append(names)
    return index
}
fn Report(b: inout Binder, module: int, index: int, message: string) {
    let source = b.project.modules[module]
    let node = source.syntax.nodes[index]
    var line = 1
    var column = 1
    for token in source.syntax.tokens {
        if token.start >= node.start { line = token.line; column = token.column; break }
    }
    b.diagnostics.append(model.Diagnostic{source: source.path, phase: "bind", message, start: node.start, end: node.end, line, column})
}
fn Define(b: inout Binder, module: int, scope: int, node: int, name: string, kind: string, mutable: bool, exported: bool) -> int {
    let names = b.names[scope]
    if names.has(name) {
        if module >= 0 { Report(&b, module, node, "Duplicate local name: " + name) }
        return names[name]
    }
    let index = len(b.symbols)
    b.symbols.append(model.Symbol{name, kind, module, node, scope, typeId: -1, mutable, exported})
    b.names[scope][name] = index
    return index
}
fn Find(b: Binder, scope: int, name: string) -> int {
    var current = scope
    while current >= 0 {
        if b.names[current].has(name) { return b.names[current][name] }
        current = b.scopes[current].parent
    }
    return -1
}
fn InoutParameter(b: Binder, module: int, index: int) -> bool {
    let nodes = b.project.modules[module].syntax.nodes
    let node = nodes[index]
    return node.kind == "parameter" && len(node.children) > 0 && nodes[node.children[0]].kind == "type_inout"
}
fn Capture(b: inout Binder, module: int, scope: int, symbol: int) {
    let defined = b.symbols[symbol]
    let owner = b.scopes[defined.scope].owner
    if owner < 0 { return }
    var current = scope
    while current >= 0 {
        let function = b.scopes[current].owner
        if function == owner { break }
        if function >= 0 {
            if InoutParameter(b, defined.module, defined.node) {
                Report(&b, module, function, "inout parameters cannot be captured"); return
            }
            var exists = false
            for captured in b.captures {
                if captured.module == module && captured.function == function && captured.symbol == symbol { exists = true; break }
            }
            if !exists { b.captures.append(model.Capture{module, function, symbol}) }
        }
        current = b.scopes[current].parent
    }
}
fn Use(b: inout Binder, module: int, scope: int, node: int, name: string) -> int {
    let symbol = Find(b, scope, name)
    if symbol < 0 { Report(&b, module, node, "Unknown name: " + name); return -1 }
    if b.tracking && b.scopes[b.symbols[symbol].scope].owner < 0 { Observe(module, name, symbol, &b) }
    b.references.append(model.Reference{module, node, symbol})
    Capture(&b, module, scope, symbol)
    return symbol
}
fn Member(b: inout Binder, module: int, scope: int, index: int) {
    let nodes = b.project.modules[module].syntax.nodes
    let node = nodes[index]
    let target = nodes[node.children[0]]
    if target.kind != "name" { Walk(&b, module, scope, node.children[0]); return }
    let symbol = Use(&b, module, scope, node.children[0], target.text)
    if symbol < 0 || b.symbols[symbol].kind != "module" { return }
    var path = ""
    for item in b.project.modules[module].imports { if item.alias == target.text { path = item.target; break } }
    var targetModule = -1
    for i, item in b.project.modules { if item.path == path { targetModule = i; break } }
    if targetModule < 0 { Report(&b, module, index, "Unresolved module: " + target.text); return }
    let names = b.names[b.moduleScopes[targetModule]]
    if !names.has(node.text) { Report(&b, module, index, "Unknown module member: " + node.text); return }
    let member = names[node.text]
    if !b.symbols[member].exported { Report(&b, module, index, "Module member is private: " + node.text); return }
    if b.tracking { Observe(targetModule, node.text, member, &b) }
    b.references.append(model.Reference{module, node: index, symbol: member})
}
fn Body(b: inout Binder, module: int, scope: int, index: int) {
    let node = b.project.modules[module].syntax.nodes[index]
    if node.kind == "block" || node.kind == "value_block" { for child in node.children { Walk(&b, module, scope, child) } }
    else { Walk(&b, module, scope, index) }
}
fn BindPattern(b: inout Binder, module: int, scope: int, index: int) {
    let node = b.project.modules[module].syntax.nodes[index]
    if node.kind == "pattern_qualifier" { return }
    if node.kind == "binding" { Define(&b, module, scope, index, node.text, "binding", false, false); return }
    for child in node.children { BindPattern(&b, module, scope, child) }
}
fn Walk(b: inout Binder, module: int, scope: int, index: int) {
    let nodes = b.project.modules[module].syntax.nodes
    let node = nodes[index]
    let kind = node.kind
    if kind == "type" || kind == "type_array" || kind == "type_fn" || kind == "type_inout" || kind == "record" || kind == "enum" || kind == "frame" || kind == "import" { return }
    if kind == "name" { Use(&b, module, scope, index, node.text); return }
    if kind == "field" { Member(&b, module, scope, index); return }
    if kind == "initializer" && len(node.children) == 0 { Use(&b, module, scope, index, node.text); return }
    if kind == "let" || kind == "var" {
        for child in node.children { Walk(&b, module, scope, child) }
        Define(&b, module, scope, index, node.text, kind, kind == "var", false)
        return
    }
    if kind == "block" || kind == "value_block" {
        let inner = Scope(&b, scope, b.scopes[scope].owner, module, index)
        Body(&b, module, inner, index)
        return
    }
    if kind == "flow" {
        if b.scopes[scope].owner >= 0 { Report(&b, module, index, "Flows must be declared at module scope"); return }
        let inner = Scope(&b, scope, index, module, index)
        let initial = Scope(&b, scope, index, module, index)
        for child in node.children {
            let item = nodes[child]
            if item.kind == "initial_parameter" {
                let symbol = Define(&b, module, initial, child, item.text, item.kind, false, false)
                b.names[inner][item.text] = symbol
            }
            if item.kind == "parameter" { Define(&b, module, inner, child, item.text, item.kind, false, false) }
        }
        // Predeclare the per-step graph so data dependencies, including forward
        // references, are resolved by symbol identity rather than spelling.
        for child in node.children {
            if nodes[child].kind != "flow_body" { continue }
            for member in nodes[child].children {
                let item = nodes[member]
                if item.kind == "flow_state" || item.kind == "flow_value" || item.kind == "flow_instance" {
                    Define(&b, module, inner, member, item.text, item.kind, false, false)
                }
            }
        }
        for child in node.children {
            if nodes[child].kind != "flow_body" { continue }
            for member in nodes[child].children {
                let item = nodes[member]
                let value = item.children[len(item.children) - 1]
                if item.kind == "flow_state" || item.kind == "flow_instance" {
                    // Creation cannot observe per-step inputs or sibling state.
                    Walk(&b, module, initial, value)
                } else {
                    if item.kind == "flow_next" { Use(&b, module, inner, member, item.text) }
                    Walk(&b, module, inner, value)
                }
            }
        }
        return
    }
    if model.NamedCallable(kind) || kind == "lambda" {
        if kind == "fn" && b.scopes[scope].owner >= 0 { Define(&b, module, scope, index, node.text, "fn", false, false) }
        let inner = Scope(&b, scope, index, module, index)
        for child in node.children {
            let item = nodes[child]
            if item.kind == "parameter" || item.kind == "type_parameter" {
                Define(&b, module, inner, child, item.text, item.kind, InoutParameter(b, module, child), false)
            }
        }
        for child in node.children {
            let item = nodes[child]
            if item.kind != "parameter" && item.kind != "type_parameter" { Body(&b, module, inner, child) }
        }
        return
    }
    if kind == "for" {
        let count = len(node.children)
        Walk(&b, module, scope, node.children[count - 2])
        let inner = Scope(&b, scope, b.scopes[scope].owner, module, node.children[count - 1])
        var cursor = 0
        while cursor < count - 2 {
            let child = node.children[cursor]
            Define(&b, module, inner, child, nodes[child].text, "binding", false, false)
            cursor += 1
        }
        Body(&b, module, inner, node.children[count - 1])
        return
    }
    if kind == "arm" {
        let inner = Scope(&b, scope, b.scopes[scope].owner, module, index)
        BindPattern(&b, module, inner, node.children[0])
        var cursor = 1
        while cursor + 1 < len(node.children) { Walk(&b, module, inner, node.children[cursor]); cursor += 1 }
        Body(&b, module, inner, node.children[len(node.children) - 1])
        return
    }
    if kind == "assign" {
        let target = nodes[node.children[0]]
        if target.kind == "name" {
            let symbol = Find(b, scope, target.text)
            if symbol >= 0 && !b.symbols[symbol].mutable { Report(&b, module, node.children[0], "Cannot rebind immutable name: " + target.text) }
        }
    }
    for child in node.children { Walk(&b, module, scope, child) }
}
export fn Bind(project: model.Project) -> model.BoundProject {
    var reuse = Begin(Empty())
    return BindQueries(project, false, map[string, bool]{}, &reuse)
}
export fn BindQueries(project: model.Project, incremental: bool, unchanged: map[string, bool], reuse: inout Reuse) -> model.BoundProject {
    var b: Binder = Binder{lookupSeen: map[string, bool]{}, tracking: incremental, lookups: [], modules: map[string, int]{}, globals: map[string, int]{}, project, scopes: [], names: [], symbols: [], references: [], captures: [], diagnostics: [], moduleScopes: []}
    if len(project.diagnostics) > 0 {
        return model.BoundProject{project, scopes: [], symbols: [], references: [], captures: [], diagnostics: project.diagnostics}
    }
    let global = Scope(&b, -1, -1, -1, -1)
    // Builtins are a fixed, unique declaration set; initialize their scope once.
    var builtinNames = map[string, int]{}
    for index, name in ["len", "slice", "string", "parseInt", "assert", "split", "join", "input", "trim", "replace", "jsonDecode", "jsonParse", "jsonStringify", "jsonKind", "jsonGet", "jsonAt", "jsonAsInt", "jsonAsString", "jsonAsBool", "jsonFrom", "jsonNull", "jsonKeys", "readText", "writeText", "float64", "int", "parseFloat64", "jsonAsFloat64", "unicodeCategory", "utf8Encode", "utf8Decode", "float64Bytes", "float64FromBytes", "crc32", "zlibCompress", "zlibDecompress", "readBytes", "writeBytes", "arrayRepeat", "readChunk", "listDirectory", "programArgs", "Space", "print", "Error", "Option", "Result", "Point3", "Vec3", "Transform3"] {
        b.symbols.append(model.Symbol{name, kind: "builtin", module: -1, node: -1, scope: global, typeId: -1, mutable: false, exported: false})
        builtinNames[name] = index
    }
    b.names[global] = builtinNames
    for module, item in project.modules {
        let scope = Scope(&b, global, -1, module, -1)
        b.moduleScopes.append(scope)
        for imported in item.imports { Define(&b, module, scope, imported.node, imported.alias, "module", false, false) }
        for declaration in item.declarations { Define(&b, module, scope, declaration.node, declaration.name, declaration.kind, false, declaration.exported) }
    }
    for module, item in project.modules { b.modules[item.path] = module }
    if incremental { for index, symbol in b.symbols { b.globals[SymbolKey(index, b)] = index } }
    for module, item in project.modules {
        for declaration in item.declarations {
            if !incremental { Walk(&b, module, b.moduleScopes[module], declaration.node); continue }
            let key = jsonStringify(jsonFrom([item.path, declaration.kind, declaration.name]))
            let sameSource = unchanged.has(item.path) && reuse.previous.entries.has(key)
            var nodes: [int] = []
            if sameSource { nodes = reuse.previous.entries[key].nodes }
            else { Syntax(module, declaration.node, b.project, &nodes) }
            if Take(module, key, sameSource, nodes, &b, &reuse) { continue }
            let firstScope = len(b.scopes)
            let firstSymbol = len(b.symbols)
            let firstReference = len(b.references)
            let firstCapture = len(b.captures)
            let firstDiagnostic = len(b.diagnostics)
            b.lookups = []; b.lookupSeen = map[string, bool]{}
            Walk(&b, module, b.moduleScopes[module], declaration.node)
            if len(b.diagnostics) == firstDiagnostic {
                Save(module, key, nodes, firstScope, firstSymbol, firstReference, firstCapture, b, &reuse)
            }
        }
    }
    // Publish each scope's name table once; the AST and symbol entries stay immutable.
    for index, scope in b.scopes {
        b.scopes[index] = model.Scope{parent: scope.parent, owner: scope.owner, module: scope.module, node: scope.node, symbols: b.names[index]}
    }
    return model.BoundProject{project, scopes: b.scopes, symbols: b.symbols, references: b.references, captures: b.captures, diagnostics: b.diagnostics}
}


fn SymbolKey(index: int, b: Binder) -> string {
    let symbol = b.symbols[index]
    if symbol.module < 0 { return "builtin:" + symbol.name }
    let source = b.project.modules[symbol.module]
    var target = ""
    if symbol.kind == "module" { for imported in source.imports { if imported.alias == symbol.name { target = imported.target; break } } }
    return jsonStringify(jsonFrom([source.path, symbol.kind, symbol.name, string(symbol.exported), target]))
}
fn Observe(module: int, name: string, symbol: int, b: inout Binder) {
    let key = string(module) + ":" + name
    if b.lookupSeen.has(key) { return }
    b.lookupSeen[key] = true
    b.lookups.append(Lookup{module: b.project.modules[module].path, name, expected: SymbolKey(symbol, b)})
}
fn Syntax(module: int, node: int, project: model.Project, nodes: inout [int]) {
    nodes.append(node)
    let item = project.modules[module].syntax.nodes[node]
    for child in item.children { Syntax(module, child, project, &nodes) }
}
fn Save(module: int, key: string, nodes: [int], firstScope: int, firstSymbol: int, firstReference: int, firstCapture: int, b: Binder, reuse: inout Reuse) {
    var scopes: [model.Scope] = []
    for offset, scope in slice(b.scopes, firstScope, len(b.scopes)) { scopes.append(scope with { symbols: b.names[firstScope + offset] }) }
    let references = slice(b.references, firstReference, len(b.references))
    let captures = slice(b.captures, firstCapture, len(b.captures))
    var external = map[string, string]{}
    for reference in references { if reference.symbol < firstSymbol { external[string(reference.symbol)] = SymbolKey(reference.symbol, b) } }
    for capture in captures { if capture.symbol < firstSymbol { external[string(capture.symbol)] = SymbolKey(capture.symbol, b) } }
    var shape: [model.Node] = []
    for node in nodes { shape.append(b.project.modules[module].syntax.nodes[node]) }
    reuse.current.entries[key] = Entry{shape, nodes, firstScope, firstSymbol, scopes, symbols: slice(b.symbols, firstSymbol, len(b.symbols)), references, captures, external, lookups: b.lookups}
}
fn Node(old: int, nodes: map[string, int]) -> int { if old < 0 { return old }; return nodes[string(old)] }
fn Take(module: int, key: string, sameSource: bool, currentNodes: [int], b: inout Binder, reuse: inout Reuse) -> bool {
    if !reuse.previous.entries.has(key) { reuse.checked += 1; return false }
    let entry = reuse.previous.entries[key]
    if len(entry.nodes) != len(currentNodes) { reuse.checked += 1; return false }
    if !sameSource {
        for offset, node in currentNodes {
            let current = b.project.modules[module].syntax.nodes[node]
            let previous = entry.shape[offset]
            if current.kind != previous.kind || current.text != previous.text || len(current.children) != len(previous.children) { reuse.checked += 1; return false }
        }
    }
    for lookup in entry.lookups {
        if !b.modules.has(lookup.module) { reuse.checked += 1; return false }
        let symbol = Find(b, b.moduleScopes[b.modules[lookup.module]], lookup.name)
        if symbol < 0 || SymbolKey(symbol, b) != lookup.expected { reuse.checked += 1; return false }
    }
    var symbols = map[string, int]{}
    for old, external in entry.external {
        if !b.globals.has(external) { reuse.checked += 1; return false }
        symbols[old] = b.globals[external]
    }
    let firstSymbol = len(b.symbols)
    let firstScope = len(b.scopes)
    let firstReference = len(b.references)
    let firstCapture = len(b.captures)
    for offset, symbol in entry.symbols { symbols[string(entry.firstSymbol + offset)] = firstSymbol + offset }
    var nodes = map[string, int]{}
    for offset, node in entry.nodes { nodes[string(node)] = currentNodes[offset] }
    for scope in entry.scopes {
        var parent = b.moduleScopes[module]
        if scope.parent >= entry.firstScope { parent = firstScope + scope.parent - entry.firstScope }
        var names = map[string, int]{}
        for name, symbol in scope.symbols { names[name] = symbols[string(symbol)] }
        b.scopes.append(scope with { parent, module, node: Node(scope.node, nodes), owner: Node(scope.owner, nodes), symbols: names })
        b.names.append(names)
    }
    for symbol in entry.symbols { b.symbols.append(symbol with { module, node: Node(symbol.node, nodes), scope: firstScope + symbol.scope - entry.firstScope, typeId: -1 }) }
    for reference in entry.references { b.references.append(reference with { module, node: Node(reference.node, nodes), symbol: symbols[string(reference.symbol)] }) }
    for capture in entry.captures { b.captures.append(capture with { module, function: Node(capture.function, nodes), symbol: symbols[string(capture.symbol)] }) }
    if currentNodes != entry.nodes {
        // Publish the relocated fragment against this revision's syntax. A
        // subsequent unchanged-module hit must not reuse older AST offsets.
        b.lookups = entry.lookups
        Save(module, key, currentNodes, firstScope, firstSymbol, firstReference, firstCapture, b, &reuse)
    } else { reuse.current.entries[key] = entry }
    reuse.hits += 1
    return true
}
export fn Size(snapshot: Snapshot) -> int {
    var size = 0
    for key, entry in snapshot.entries {
        size += len(entry.shape) + len(entry.nodes) + len(entry.scopes) + len(entry.symbols) + len(entry.references) + len(entry.captures) + len(entry.external) + len(entry.lookups) + 1
        for node in entry.shape { size += len(node.children) }
        for scope in entry.scopes { size += len(scope.symbols) }
    }
    return size
}
