import "model.pxl" as model
import "types.pxl" as types
import "syntax_index.pxl" as syntaxIndex

// Materialize a finite graph, retaining arena IDs for recursive references.
export fn Materialize(roots: [int], resolved: inout model.ResolvedTypes) -> model.SchemaPlan {
    var result: model.SchemaPlan = model.SchemaPlan{schemas: [], diagnostics: []}
    var pending = roots
    var seen: map[string, bool] = map[string, bool]{}
    var cursor = 0
    var genericCount = 0
    while cursor < len(pending) {
        let typeId = pending[cursor]
        cursor += 1
        let key = string(typeId)
        if seen.has(key) { continue }
        seen[key] = true
        if !types.Concrete(typeId, 0, resolved) {
            result.diagnostics.append(model.Diagnostic{source: "", phase: "schemas", message: "Schema requires a concrete type within depth 32", start: 0, end: 0, line: 1, column: 1})
            break
        }
        let typ = resolved.types[typeId]
        for argument in typ.arguments { pending.append(argument) }
        if typ.kind != "record" && typ.kind != "enum" { continue }
        if len(typ.arguments) > 0 && genericCount >= 256 {
            result.diagnostics.append(model.Diagnostic{source: "", phase: "schemas", message: "Generic nominal schema limit 256 exceeded", start: 0, end: 0, line: 1, column: 1})
            break
        }
        if len(typ.arguments) > 0 { genericCount += 1 }
        var fields: [model.TypeField] = []
        var variants: [model.TypeVariant] = []
        if typ.kind == "record" {
            for field in types.FieldTypes(typeId, &resolved) {
                fields.append(field)
                pending.append(field.typeId)
            }
        } else {
            for variant in types.VariantTypes(typeId, &resolved) {
                variants.append(variant)
                for field in variant.fields { pending.append(field.typeId) }
            }
        }
        result.schemas.append(model.NominalSchema{typeId, fields: fields, variants: variants})
    }
    return result
}

export fn Build(planned: inout model.ClosurePlan) -> model.SchemaPlan {
    if len(planned.diagnostics) > 0 { return model.SchemaPlan{schemas: [], diagnostics: slice(planned.diagnostics, 0, len(planned.diagnostics))} }


    var roots: [int] = []
    var owners: [[int]] = []
    for module in planned.named.checked.resolved.bound.project.modules { owners.append(syntaxIndex.Owners(module.syntax)) }
    var signatures: map[string, int] = map[string, int]{}
    var locals: map[string, [int]] = map[string, [int]]{}
    var expressions: map[string, [int]] = map[string, [int]]{}
    for index, signature in planned.named.checked.resolved.signatures {
        let key = syntaxIndex.Key(signature.module, signature.node)
        signatures[key] = index; locals[key] = []; expressions[key] = []
    }
    for index, local in planned.named.checked.resolved.bound.symbols {
        if local.node < 0 { continue }
        if local.kind != "let" && local.kind != "var" && local.kind != "parameter" && local.kind != "initial_parameter" && local.kind != "binding" { continue }
        let owner = owners[local.module][local.node]
        if owner >= 0 { locals[syntaxIndex.Key(local.module, owner)].append(index) }
    }
    for index, expression in planned.named.checked.expressions {
        let owner = owners[expression.module][expression.node]
        if owner >= 0 { expressions[syntaxIndex.Key(expression.module, owner)].append(index) }
    }
    for instance in planned.named.instances {
        roots.append(instance.typeId)
        let symbol = planned.named.checked.resolved.bound.symbols[instance.symbol]
        let key = syntaxIndex.Key(symbol.module, symbol.node)
        let signature = planned.named.checked.resolved.signatures[signatures[key]]
        for index in locals[key] {
            let local = planned.named.checked.resolved.bound.symbols[index]
            roots.append(types.Substitute(local.typeId, signature.parameters, instance.arguments, &planned.named.checked.resolved))
        }
        for index in expressions[key] {
            let expression = planned.named.checked.expressions[index]
            let concrete = types.Substitute(expression.typeId, signature.parameters, instance.arguments, &planned.named.checked.resolved)
            // Open generic names are not runtime schema roots.
            if types.Concrete(concrete, 0, planned.named.checked.resolved) { roots.append(concrete) }
        }
    }
    for closure in planned.closures {
        roots.append(closure.typeId)
        for capture in closure.captures { roots.append(capture.typeId) }
    }
    return Materialize(roots, &planned.named.checked.resolved)
}
