import "model.pxl" as model
import "types.pxl" as types

fn Key(module: int, node: int) -> string = string(module) + ":" + string(node)
fn Contains(outer: model.Node, inner: model.Node) -> bool = outer.start <= inner.start && outer.end >= inner.end
record Builder { closures: [model.ClosureInstance], diagnostics: [model.Diagnostic] }
fn Publish(plan: Builder, named: model.InstancePlan) -> model.ClosurePlan = model.ClosurePlan{named: named, closures: plan.closures, diagnostics: plan.diagnostics}
fn Report(module: int, index: int, message: string, named: model.InstancePlan, plan: inout Builder) {
    let source = named.checked.resolved.bound.project.modules[module]
    let node = source.syntax.nodes[index]
    var line = 1
    var column = 1
    for token in source.syntax.tokens { if token.start >= node.start { line = token.line; column = token.column; break } }
    plan.diagnostics.append(model.Diagnostic{source: source.path, phase: "closures", message, start: node.start, end: node.end, line, column})
}
export fn Build(inputNamed: model.InstancePlan) -> model.ClosurePlan {
    var named = inputNamed
    var result: Builder = Builder{closures: [], diagnostics: named.diagnostics}
    if len(result.diagnostics) > 0 { return Publish(result, named) }

    var expressionTypes: map[string, int] = map[string, int]{}
    var signatures: map[string, int] = map[string, int]{}
    for expression in named.checked.expressions { expressionTypes[Key(expression.module, expression.node)] = expression.typeId }
    for index, signature in named.checked.resolved.signatures { signatures[Key(signature.module, signature.node)] = index }
    for owner, instance in named.instances {
        let symbol = named.checked.resolved.bound.symbols[instance.symbol]
        let nodes = named.checked.resolved.bound.project.modules[symbol.module].syntax.nodes
        let function = nodes[symbol.node]
        let signature = named.checked.resolved.signatures[signatures[Key(symbol.module, symbol.node)]]
        for candidate in named.checked.resolved.signatures {
            if candidate.module != symbol.module { continue }
            let node = nodes[candidate.node]
            if node.kind != "lambda" || !Contains(function, node) { continue }
            var belongs = true
            for other in named.checked.resolved.signatures {
                if other.module != symbol.module || other.node == symbol.node { continue }
                let inner = nodes[other.node]
                if model.NamedCallable(inner.kind) && Contains(function, inner) && Contains(inner, node) { belongs = false; break }
            }
            if !belongs { continue }
            let key = Key(symbol.module, candidate.node)
            if !expressionTypes.has(key) { Report(symbol.module, candidate.node, "Closure has no checked expression type", named, &result); continue }
            let typeId = types.Substitute(expressionTypes[key], signature.parameters, instance.arguments, &named.checked.resolved)
            if !types.Concrete(typeId, 0, named.checked.resolved) { Report(symbol.module, candidate.node, "Closure type is not concrete or exceeds depth 32", named, &result); continue }
            var captures: [model.CaptureSlot] = []
            for capture in named.checked.resolved.bound.captures {
                if capture.module != symbol.module || capture.function != candidate.node { continue }
                let captured = named.checked.resolved.bound.symbols[capture.symbol]
                let captureType = types.Substitute(captured.typeId, signature.parameters, instance.arguments, &named.checked.resolved)
                if !types.Concrete(captureType, 0, named.checked.resolved) { Report(symbol.module, candidate.node, "Capture type is not concrete: " + captured.name, named, &result) }
                captures.append(model.CaptureSlot{symbol: capture.symbol, typeId: captureType, mutable: false})
            }
            result.closures.append(model.ClosureInstance{owner, module: symbol.module, node: candidate.node, parent: -1, typeId, captures: captures})
        }
    }
    for index, closure in result.closures {
        let nodes = named.checked.resolved.bound.project.modules[closure.module].syntax.nodes
        var parentId = -1
        for parent, candidate in result.closures {
            if parent == index || candidate.owner != closure.owner { continue }
            if !Contains(nodes[candidate.node], nodes[closure.node]) { continue }
            if parentId < 0 { parentId = parent }
            else {
                let previous = nodes[result.closures[parentId].node]
                let next = nodes[candidate.node]
                if next.end - next.start < previous.end - previous.start { parentId = parent }
            }
        }
        result.closures[index] = model.ClosureInstance{owner: closure.owner, module: closure.module, node: closure.node, parent: parentId, typeId: closure.typeId, captures: closure.captures}
    }
    return Publish(result, named)
}
