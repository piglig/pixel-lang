import "model.pxl" as model

// Render the compiler's decoded semantic AST, never source hidden in image metadata.
export record Output { entry: string, files: map[string], diagnostics: [model.Diagnostic] }
record Writer { nodes: [model.Node], names: map[string], paths: map[string], module: string }
fn Relative(from: string, target: string) -> string {
    if len(target) >= 4 && slice(target, 0, 4) == "std/" { return target }
    let left = split(from, "/")
    let right = split(target, "/")
    var common = 0
    while common < len(left) - 1 && common < len(right) - 1 && left[common] == right[common] { common += 1 }
    let parts: [string] = []
    var i = common
    while i < len(left) - 1 { append(parts, ".."); i += 1 }
    while common < len(right) { append(parts, right[common]); common += 1 }
    return join(parts, "/")
}
fn Name(w: Writer, text: string) -> string {
    let parts = split(text, ".")
    if len(parts) == 2 && has(w.names, parts[0] + ":" + parts[1]) { return parts[0] + "." + w.names[parts[0] + ":" + parts[1]] }
    if has(w.names, w.module + ":" + text) { return w.names[w.module + ":" + text] }
    return text
}
fn List(w: Writer, children: [int], start: int, end: int) -> string {
    let parts: [string] = []
    var i = start
    while i < end { append(parts, Write(w, children[i])); i += 1 }
    return join(parts, ", ")
}
fn Generics(w: Writer, children: [int]) -> string {
    let parts: [string] = []
    for child in children { if w.nodes[child].kind == "type_parameter" { append(parts, Name(w, w.nodes[child].text)) } }
    if len(parts) == 0 { return "" }
    return "[" + join(parts, ", ") + "]"
}
fn Function(w: Writer, node: model.Node) -> string {
    let params: [string] = []
    var result = ""
    var body = ""
    for child in node.children {
        let item = w.nodes[child]
        if item.kind == "parameter" { append(params, Name(w, item.text) + ": " + Write(w, item.children[0])) }
        else if item.kind == "result" { result = " -> " + Write(w, item.children[0]) }
        else if item.kind == "block" { body = Write(w, child) }
        else if item.kind == "expression_body" { body = "= " + Write(w, item.children[0]) }
    }
    var name = ""
    if node.kind == "fn" { name = " " + Name(w, node.text) }
    return "fn" + name + Generics(w, node.children) + "(" + join(params, ", ") + ")" + result + " " + body
}
fn Arm(w: Writer, node: model.Node) -> string {
    let pattern = w.nodes[node.children[0]]
    var text = "_"
    if pattern.kind == "variant_pattern" {
        let typ = w.nodes[pattern.children[0]]
        text = pattern.text
        if typ.text != "Option" { text = Write(w, pattern.children[0]) + "." + text }
        if len(node.children) > 2 { text += "(" + List(w, node.children, 1, len(node.children) - 1) + ")" }
    }
    return text + " => " + Write(w, node.children[len(node.children) - 1])
}
fn Write(w: Writer, index: int) -> string {
    let n = w.nodes[index]
    let k = n.kind
    let c = n.children
    if k == "name" || k == "binding" || k == "type_parameter" { return Name(w, n.text) }
    if k == "literal_str" || k == "literal_string" { return jsonStringify(jsonFrom(n.text)) }
    if k == "literal_int" || k == "literal_float" || k == "literal_float64" || k == "literal_keyword" { return n.text }
    if k == "type" {
        let name = Name(w, n.text)
        if len(c) == 0 { return name }
        return name + "[" + List(w, c, 0, len(c)) + "]"
    }
    if k == "type_array" { return "[" + Write(w, c[0]) + "]" }
    if k == "type_fn" { return "fn(" + List(w, c, 0, len(c) - 1) + ")->" + Write(w, c[len(c) - 1]) }
    if k == "binary" { return "(" + Write(w, c[0]) + " " + n.text + " " + Write(w, c[1]) + ")" }
    if k == "unary" { return "(" + n.text + Write(w, c[0]) + ")" }
    if k == "annotate" { return "(" + Write(w, c[0]) + ": " + Write(w, c[1]) + ")" }
    if k == "call" { return Write(w, c[0]) + "(" + List(w, c, 1, len(c)) + ")" }
    if k == "specialize" { return Write(w, c[0]) + "[" + List(w, c, 1, len(c)) + "]" }
    if k == "index" { return Write(w, c[0]) + "[" + Write(w, c[1]) + "]" }
    if k == "field" {
        let target = w.nodes[c[0]]
        if target.kind == "name" && has(w.paths, target.text + ".pxl") {
            return Name(w, target.text + "." + n.text)
        }
        return Write(w, c[0]) + "." + n.text
    }
    if k == "array" { return "[" + List(w, c, 0, len(c)) + "]" }
    if k == "map_entry" { return Write(w, c[0]) + ": " + Write(w, c[1]) }
    if k == "map" { return "map[" + Write(w, c[0]) + "]{" + List(w, c, 1, len(c)) + "}" }
    if k == "map_inferred" { return "{" + List(w, c, 0, len(c)) + "}" }
    if k == "construct" { return Write(w, c[0]) + "{" + List(w, c, 1, len(c)) + "}" }
    if k == "initializer" { return n.text + ": " + Write(w, c[0]) }
    if k == "lambda" { return "(" + Function(w, n) + ")" }
    if k == "fn" { return Function(w, n) }
    if k == "record" || k == "enum" {
        let fields: [string] = []
        for child in c { if w.nodes[child].kind != "type_parameter" { append(fields, Write(w, child)) } }
        return k + " " + Name(w, n.text) + Generics(w, c) + " { " + join(fields, ", ") + " }"
    }
    if k == "field_decl" || k == "parameter" { return n.text + ": " + Write(w, c[0]) }
    if k == "variant_decl" {
        if len(c) == 0 { return n.text }
        return n.text + "(" + List(w, c, 0, len(c)) + ")"
    }
    if k == "export" { return "export " + Write(w, c[0]) }
    if k == "import" {
        var path = n.text
        if has(w.paths, path) { path = Relative(w.paths[w.module + ".pxl"], w.paths[path]) }
        return "import " + jsonStringify(jsonFrom(path)) + " as " + w.nodes[c[0]].text
    }
    if k == "block" {
        let lines: [string] = []
        for child in c { append(lines, Write(w, child)) }
        return "{\n" + join(lines, "\n") + "\n}"
    }
    if k == "let" || k == "var" {
        var annotation = ""
        if len(c) == 2 { annotation = ": " + Write(w, w.nodes[c[0]].children[0]) }
        return k + " " + Name(w, n.text) + annotation + " = " + Write(w, c[len(c) - 1])
    }
    if k == "assign" { return Write(w, c[0]) + " " + n.text + " " + Write(w, c[1]) }
    if k == "expression_stmt" { return Write(w, c[0]) }
    if k == "return" {
        if len(c) == 0 { return "return" }
        return "return " + Write(w, c[0])
    }
    if k == "break" || k == "continue" { return k }
    if k == "if" || k == "while" {
        var text = k + " (" + Write(w, c[0]) + ") " + Write(w, c[1])
        if len(c) == 3 { text += " else " + Write(w, c[2]) }
        return text
    }
    if k == "for" { return "for " + List(w, c, 0, len(c) - 2) + " in (" + Write(w, c[len(c) - 2]) + ") " + Write(w, c[len(c) - 1]) }
    if k == "try" { return "try " + Write(w, c[0]) + " catch " + Name(w, n.text) + " " + Write(w, c[1]) }
    if k == "match" || k == "match_stmt" {
        let arms: [string] = []
        var i = 1
        while i < len(c) { append(arms, Arm(w, w.nodes[c[i]])); i += 1 }
        let text = "match (" + Write(w, c[0]) + ") {\n" + join(arms, ",\n") + "\n}"
        if k == "match" { return "(" + text + ")" }
        return text
    }
    fail("Unsupported recovered AST node: " + k)
    return ""
}
export fn Build(project: model.Project, names: map[string], paths: map[string]) -> Output {
    let output = Output{entry: "_module_0.pxl", files: map[string]{}, diagnostics: project.diagnostics}
    if len(output.diagnostics) > 0 { return output }
    for module in project.modules {
        let moduleName = slice(module.path, 0, len(module.path) - 4)
        let w = Writer{nodes: module.syntax.nodes, names, paths, module: moduleName}
        let lines: [string] = []
        for root in module.syntax.roots { append(lines, Write(w, root)) }
        var path = module.path
        if has(paths, path) { path = paths[path] }
        output.files[path] = join(lines, "\n\n") + "\n"
        if module.path == "_module_0.pxl" { output.entry = path }
    }
    return output
}
