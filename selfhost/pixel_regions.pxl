import "pixel_decode.pxl" as decoder
import "spatial_layout.pxl" as layout

export record Region { id: int, tokens: [decoder.Token], parent: int }
export record Output { regions: [Region], diagnostics: [decoder.Diagnostic] }
fn Key(position: [int]) -> string = string(position[0]) + ":" + string(position[1])
export fn Named(token: decoder.Token, name: string) -> bool {
    match jsonAsString(token.value) {
        .Ok(value) => { return value == name },
        .Err(error) => { return false }
    }
}
fn Before(a: decoder.Token, b: decoder.Token) -> bool {
    return a.position[1] < b.position[1] || (a.position[1] == b.position[1] && a.position[0] <= b.position[0])
}
fn Order(tokens: [decoder.Token]) -> [decoder.Token] {
    var sorted = true
    var index = 1
    while index < len(tokens) { if !Before(tokens[index - 1], tokens[index]) { sorted = false; break }; index += 1 }
    if sorted { return tokens }
    let middle = len(tokens) / 2
    let left = Order(slice(tokens, 0, middle))
    let right = Order(slice(tokens, middle, len(tokens)))
    var result: [decoder.Token] = []
    var a = 0
    var b = 0
    while a < len(left) || b < len(right) {
        if b == len(right) || (a < len(left) && Before(left[a], right[b])) { result.append(left[a]); a += 1 }
        else { result.append(right[b]); b += 1 }
    }
    return result
}
fn Report(source: string, position: [int], message: string, output: inout Output) {
    output.diagnostics.append(decoder.Diagnostic{source, phase: "spatial", message, position: slice(position, 0, len(position))})
    output.regions = []
}
export fn Analyze(decoded: decoder.Output, links: [layout.PixelLink], source: string) -> Output {
    var output: Output = Output{regions: [], diagnostics: decoded.diagnostics}
    if len(output.diagnostics) > 0 { return output }
    return Explicit(decoded, links, source)
}

fn Parents(input: Output, links: [layout.PixelLink], regionAt: map[string, int], source: string) -> Output {
    var output = input
    for link in links {
        if link.kind != "child" { continue }
        let parent = regionAt[Key(link.from)]
        let child = regionAt[Key(link.to)]
        let region = output.regions[child]
        if parent >= child || region.parent >= 0 { Report(source, link.to, "Child must follow one unique parent region", &output); return output }
        output.regions[child].parent = parent
    }
    let openers = ["if", "else", "while", "fn", "effect_fn", "flow", "lambda_body", "effect_body", "value_body", "for", "match", "case"]
    for region in output.regions {
        if region.parent < 0 { continue }
        let parent = output.regions[region.parent]
        var index = 0
        while index + 1 < len(parent.tokens) && (Named(parent.tokens[index], "export") || Named(parent.tokens[index], "entry")) { index += 1 }
        var valid = false
        for opener in openers { if Named(parent.tokens[index], opener) { valid = true } }
        if !valid { Report(source, region.tokens[0].position, "Nested region requires a condition, loop or function parent", &output); return output }
    }
    return output
}

fn Explicit(decoded: decoder.Output, links: [layout.PixelLink], source: string) -> Output {
    var output: Output = Output{regions: [], diagnostics: []}
    let tokens = Order(decoded.tokens)
    var positions: map[string, int] = map[string, int]{}
    for index, token in tokens { positions[Key(token.position)] = index }
    var heads: map[string, bool] = map[string, bool]{}
    var next: map[string, int] = map[string, int]{}
    var incoming: map[string, bool] = map[string, bool]{}
    var explicitRows: map[string, bool] = map[string, bool]{}
    for link in links {
        if len(link.from) != 2 || len(link.to) != 2 { Report(source, link.from, "Connection requires two-dimensional endpoints", &output); return output }
        let from = Key(link.from)
        let to = Key(link.to)
        if !positions.has(from) || !positions.has(to) { Report(source, link.from, "Connection endpoint is not a semantic pixel", &output); return output }
        if link.kind == "region" {
            if from != to || heads.has(from) { Report(source, link.from, "Region marker must uniquely point to itself", &output); return output }
            heads[from] = true
        } else if link.kind == "next" {
            if link.from[1] != link.to[1] || next.has(from) || incoming.has(to) { Report(source, link.from, "Invalid explicit region chain", &output); return output }
            next[from] = positions[to]; incoming[to] = true
            explicitRows[string(link.from[1])] = true
        } else if link.kind != "child" { Report(source, link.from, "Unknown connection kind", &output); return output }
    }
    var index = 1
    while index < len(tokens) {
        let a = tokens[index - 1].position
        let b = tokens[index].position
        if a[1] == b[1] && !explicitRows.has(string(a[1])) && !heads.has(Key(b)) && b[0] - a[0] <= 3 {
            next[Key(a)] = index; incoming[Key(b)] = true
        }
        index += 1
    }
    var regionAt: map[string, int] = map[string, int]{}
    for token in tokens {
        let head = Key(token.position)
        if !heads.has(head) { continue }
        if incoming.has(head) { Report(source, token.position, "Region head cannot have an incoming next link", &output); return output }
        var region: Region = Region{id: len(output.regions), tokens: [], parent: -1}
        var cursor = positions[head]
        while cursor >= 0 {
            let item = tokens[cursor]
            let key = Key(item.position)
            if regionAt.has(key) { Report(source, item.position, "Cyclic or overlapping explicit regions", &output); return output }
            regionAt[key] = region.id; region.tokens.append(item)
            if next.has(key) { cursor = next[key] } else { cursor = -1 }
        }
        output.regions.append(region)
    }
    if len(regionAt) != len(tokens) { Report(source, [], "Explicit regions must cover every semantic pixel", &output); return output }
    return Parents(output, links, regionAt, source)
}
