import "pixel_tokens.pxl" as symbols
import "spatial_layout.pxl" as layout

export record Token { kind: string, value: json, position: [int] }
export record Diagnostic { source: string, phase: string, message: string, position: [int] }
export record Output { tokens: [Token], diagnostics: [Diagnostic] }
export record Literal { kind: string, value: json, next: int, diagnostics: [Diagnostic] }
fn Report(source: string, position: [int], message: string, diagnostics: inout [Diagnostic]) {
    diagnostics.append(Diagnostic{source, phase: "encoding", message, position: slice(position, 0, len(position))})
}
export fn Decode(document: layout.Source, source: string) -> Output = Scan(document, source, true)
export fn Validate(document: layout.Source, source: string) -> [Diagnostic] = Scan(document, source, false).diagnostics
fn Scan(document: layout.Source, source: string, collect: bool) -> Output {
    var output: Output = Output{tokens: [], diagnostics: []}
    if document.magic != "PIXELLANG" || document.encoding != "rgba8" || len(document.versions) != 3 {
        Report(source, [], "Unsupported magic, version axes or encoding", &output.diagnostics); return output
    }
    for axis in ["language", "encoding", "format"] {
        if !document.versions.has(axis) || document.versions[axis] != "0.9" {
            Report(source, [], "Unsupported version axis: " + axis, &output.diagnostics); return output
        }
    }
    let dims = document.dimensions
    if len(dims) != 2 { Report(source, [], "Expected two dimensions", &output.diagnostics); return output }
    if dims[0] < 1 || dims[1] < 1 || dims[0] > 1000000 / dims[1] || len(document.pixels) > 1000000 {
        Report(source, [], "Source exceeds one million logical cells", &output.diagnostics); return output
    }
    // Resolve the fixed vocabulary once, not once per semantic pixel.
    let tables = map[int, [string]]{48: symbols.Names(48), 64: symbols.Names(64), 80: symbols.Names(80), 96: symbols.Names(96), 128: symbols.Names(128)}
    var seen: map[int, bool] = map[int, bool]{}
    for pixel in document.pixels {
        let position = pixel.position
        if len(position) != 2 { Report(source, position, "Pixel requires two coordinates", &output.diagnostics); continue }
        if position[0] < 0 || position[1] < 0 || position[0] >= dims[0] || position[1] >= dims[1] {
            Report(source, position, "Pixel lies outside dimensions", &output.diagnostics); continue
        }
        // Bounds above make this mapping injective within one million cells.
        let key = position[1] * dims[0] + position[0]
        if seen.has(key) { Report(source, position, "Duplicate pixel position", &output.diagnostics); continue }
        seen[key] = true
        let color = pixel.rgba
        if len(color) != 4 { Report(source, position, "RGBA requires four bytes", &output.diagnostics); continue }
        var valid = true
        for channel in color { if channel < 0 || channel > 255 { valid = false } }
        if !valid { Report(source, position, "RGBA channels must be bytes", &output.diagnostics); continue }
        if color[3] == 0 { continue }
        if color[3] != 255 { Report(source, position, "Semantic pixels require alpha 255", &output.diagnostics); continue }
        let category = color[0]
        let payload = color[1] * 256 + color[2]
        var kind = ""
        var value = jsonNull()
        if collect { value = jsonFrom(payload) }
        if category == 16 { kind = "int"; if collect && payload >= 32768 { value = jsonFrom(payload - 65536) } }
        else if category == 17 && payload < 2 { kind = "bool"; if collect { value = jsonFrom(payload == 1) } }
        else if category == 32 { kind = "id" }
        else if category == 18 { kind = "integer_head" }
        else if category == 19 { kind = "string_head" }
        else if category == 20 { kind = "float_head" }
        else if category == 112 { kind = "word" }
        else {
            let names = match tables.get(category) { .Some(value) => value, .None => [] }
            if payload < len(names) {
                if collect { value = jsonFrom(names[payload]) }
                if category == 48 { kind = "op" }
                else if category == 64 { kind = "keyword" }
                else if category == 80 { kind = "punct" }
                else if category == 96 { kind = "type" }
                else if category == 128 { kind = "builtin" }
            }
        }
        if kind == "" { Report(source, position, "Unknown RGBA semantic encoding", &output.diagnostics) }
        else if collect { output.tokens.append(Token{kind, value, position}) }
    }
    if len(output.diagnostics) > 0 { output.tokens = [] }
    return output
}

// Consume tokens in spatial traversal order; never infer adjacency from colors.
export fn ReadLiteral(tokens: [Token], start: int, source: string) -> Literal {
    var result: Literal = Literal{kind: "", value: jsonNull(), next: start, diagnostics: []}
    if start < 0 || start >= len(tokens) { Report(source, [], "Missing literal", &result.diagnostics); return result }
    let head = tokens[start]
    if head.kind == "int" || head.kind == "bool" {
        result.kind = head.kind; result.value = head.value; result.next = start + 1; return result
    }
    if head.kind != "integer_head" && head.kind != "string_head" && head.kind != "float_head" {
        Report(source, head.position, "Expected a literal head", &result.diagnostics); return result
    }
    var payload = 0
    match jsonAsInt(head.value) {
        .Ok(value) => { payload = value },
        .Err(error) => { Report(source, head.position, error.message, &result.diagnostics); return result }
    }
    if payload < 0 || payload > 65535 { Report(source, head.position, "Literal payload must be a word", &result.diagnostics); return result }
    if head.kind != "string_head" && payload != 0 { Report(source, head.position, "Reserved literal head payload must be zero", &result.diagnostics); return result }
    var count = 4
    if head.kind == "string_head" { count = (payload + 1) / 2 }
    if count > len(tokens) - start - 1 { Report(source, head.position, "Truncated literal words", &result.diagnostics); return result }
    var words: [int] = []
    var bytes: [int] = []
    var cursor = start + 1
    while cursor <= start + count {
        let word = tokens[cursor]
        if word.kind != "word" { Report(source, word.position, "Literal requires data words", &result.diagnostics); return result }
        var value = 0
        match jsonAsInt(word.value) {
            .Ok(decoded) => { value = decoded },
            .Err(error) => { Report(source, word.position, error.message, &result.diagnostics); return result }
        }
        if value < 0 || value > 65535 { Report(source, word.position, "Literal data must be a word", &result.diagnostics); return result }
        words.append(value); bytes.append(value / 256); bytes.append(value % 256)
        cursor += 1
    }
    if head.kind == "integer_head" {
        var value = words[0]
        if value >= 32768 { value -= 65536 }
        for word in slice(words, 1, 4) { value = value * 65536 + word }
        result.kind = "int"; result.value = jsonFrom(value)
    } else {
        if head.kind == "float_head" {
            match float64FromBytes(bytes) {
                .Ok(value) => { result.value = jsonFrom(value); result.kind = "float64" },
                .Err(error) => { Report(source, head.position, error.message, &result.diagnostics); return result }
            }
        } else {
            if payload % 2 == 1 && bytes[len(bytes) - 1] != 0 { Report(source, head.position, "Invalid string padding", &result.diagnostics); return result }
            match utf8Decode(slice(bytes, 0, payload)) {
                .Ok(value) => { result.value = jsonFrom(value); result.kind = "str" },
                .Err(error) => { Report(source, head.position, error.message, &result.diagnostics); return result }
            }
        }
    }
    result.next = cursor
    return result
}
