import "pixel_tokens.pxl" as symbols
import "spatial_layout.pxl" as layout

export record Token { kind: string, value: json, position: [int] }
export record Diagnostic { source: string, phase: string, message: string, position: [int] }
export record Output { tokens: [Token], diagnostics: [Diagnostic] }
export record Literal { kind: string, value: json, next: int, diagnostics: [Diagnostic] }
fn Report(diagnostics: [Diagnostic], source: string, position: [int], message: string) {
    append(diagnostics, Diagnostic{source, phase: "encoding", message, position: slice(position, 0, len(position))})
}
export fn Decode(document: layout.Source, source: string) -> Output {
    let output = Output{tokens: [], diagnostics: []}
    if document.magic != "PIXELLANG" || document.encoding != "rgba8" || len(document.versions) != 3 {
        Report(output.diagnostics, source, [], "Unsupported magic, version axes or encoding"); return output
    }
    for axis in ["language", "encoding", "format"] {
        if !has(document.versions, axis) || document.versions[axis] != "0.8" {
            Report(output.diagnostics, source, [], "Unsupported version axis: " + axis); return output
        }
    }
    let dims = document.dimensions
    if len(dims) != 2 { Report(output.diagnostics, source, [], "Expected two dimensions"); return output }
    if dims[0] < 1 || dims[1] < 1 || dims[0] > 1000000 / dims[1] || len(document.pixels) > 1000000 {
        Report(output.diagnostics, source, [], "Source exceeds one million logical cells"); return output
    }
    let seen = map[bool]{}
    for pixel in document.pixels {
        let position = pixel.position
        if len(position) != 2 { Report(output.diagnostics, source, position, "Pixel requires two coordinates"); continue }
        if position[0] < 0 || position[1] < 0 || position[0] >= dims[0] || position[1] >= dims[1] {
            Report(output.diagnostics, source, position, "Pixel lies outside dimensions"); continue
        }
        let key = string(position[0]) + ":" + string(position[1])
        if has(seen, key) { Report(output.diagnostics, source, position, "Duplicate pixel position"); continue }
        seen[key] = true
        let color = pixel.rgba
        if len(color) != 4 { Report(output.diagnostics, source, position, "RGBA requires four bytes"); continue }
        var valid = true
        for channel in color { if channel < 0 || channel > 255 { valid = false } }
        if !valid { Report(output.diagnostics, source, position, "RGBA channels must be bytes"); continue }
        if color[3] == 0 { continue }
        if color[3] != 255 { Report(output.diagnostics, source, position, "Semantic pixels require alpha 255"); continue }
        let category = color[0]
        let payload = color[1] * 256 + color[2]
        var kind = ""
        var value = jsonFrom(payload)
        if category == 16 { kind = "int"; if payload >= 32768 { value = jsonFrom(payload - 65536) } }
        else if category == 17 && payload < 2 { kind = "bool"; value = jsonFrom(payload == 1) }
        else if category == 32 { kind = "id" }
        else if category == 18 { kind = "integer_head" }
        else if category == 19 { kind = "string_head" }
        else if category == 20 { kind = "float_head" }
        else if category == 112 { kind = "word" }
        else {
            let names = symbols.Names(category)
            if payload < len(names) {
                value = jsonFrom(names[payload])
                if category == 48 { kind = "op" }
                else if category == 64 { kind = "keyword" }
                else if category == 80 { kind = "punct" }
                else if category == 96 { kind = "type" }
                else if category == 128 { kind = "builtin" }
            }
        }
        if kind == "" { Report(output.diagnostics, source, position, "Unknown RGBA semantic encoding") }
        else { append(output.tokens, Token{kind, value, position: slice(position, 0, 2)}) }
    }
    if len(output.diagnostics) > 0 { output.tokens = [] }
    return output
}

// Consume tokens in spatial traversal order; never infer adjacency from colors.
export fn ReadLiteral(tokens: [Token], start: int, source: string) -> Literal {
    let result = Literal{kind: "", value: jsonNull(), next: start, diagnostics: []}
    if start < 0 || start >= len(tokens) { Report(result.diagnostics, source, [], "Missing literal"); return result }
    let head = tokens[start]
    if head.kind == "int" || head.kind == "bool" {
        result.kind = head.kind; result.value = head.value; result.next = start + 1; return result
    }
    if head.kind != "integer_head" && head.kind != "string_head" && head.kind != "float_head" {
        Report(result.diagnostics, source, head.position, "Expected a literal head"); return result
    }
    let payload = jsonAsInt(head.value)
    if head.kind != "string_head" && payload != 0 { Report(result.diagnostics, source, head.position, "Reserved literal head payload must be zero"); return result }
    var count = 4
    if head.kind == "string_head" { count = (payload + 1) / 2 }
    if count > len(tokens) - start - 1 { Report(result.diagnostics, source, head.position, "Truncated literal words"); return result }
    let words: [int] = []
    let bytes: [int] = []
    var cursor = start + 1
    while cursor <= start + count {
        let word = tokens[cursor]
        if word.kind != "word" { Report(result.diagnostics, source, word.position, "Literal requires data words"); return result }
        let value = jsonAsInt(word.value)
        append(words, value); append(bytes, value / 256); append(bytes, value % 256)
        cursor += 1
    }
    if head.kind == "integer_head" {
        var value = words[0]
        if value >= 32768 { value -= 65536 }
        for word in slice(words, 1, 4) { value = value * 65536 + word }
        result.kind = "int"; result.value = jsonFrom(value)
    } else {
        try {
            if head.kind == "float_head" { result.value = jsonFrom(float64FromBytes(bytes)); result.kind = "float64" }
            else {
                if payload % 2 == 1 && bytes[len(bytes) - 1] != 0 { Report(result.diagnostics, source, head.position, "Invalid string padding"); return result }
                result.value = jsonFrom(utf8Decode(slice(bytes, 0, payload))); result.kind = "str"
            }
        } catch err { Report(result.diagnostics, source, head.position, err.message); return result }
    }
    result.next = cursor
    return result
}
