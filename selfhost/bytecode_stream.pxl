import "assembler.pxl" as assembler
import "model.pxl" as model
import "ir_state.pxl" as state

record Header { kind: string, protocol: int, magic: string, vm_version: string, language_version: string, compiler_version: string, coordinateFrames: map[string, string], effectFunctions: [string], entry: [string], diagnostics: [model.Diagnostic] }
record Item { kind: string, name: string, value: json }
record FunctionHeader { kind: string, name: string, params: [string], captures: [string], locals: int, result: string }
record CompactInstruction { op: string, arg: json, module: int, node: int, span: int }
record End { kind: string, flows: int, records: int, enums: int, constants: int, functions: int, instructions: int, spans: int }

// Each event stays independently bounded; no whole-program JSON value is built.
export effect fn Emit(output: assembler.Output) {
    let code = output.bytecode
    print(jsonFrom(Header{kind: "header", protocol: 2, magic: code.magic, vm_version: code.vm_version, language_version: code.language_version, compiler_version: code.compiler_version, coordinateFrames: code.coordinateFrames, effectFunctions: code.effectFunctions, entry: code.entry, diagnostics: output.diagnostics}))
    var instructions = 0
    var spans: map[string, int] = map[string, int]{}
    if len(output.diagnostics) == 0 {
        for name, flow in code.flows { print(jsonFrom(Item{kind: "flow", name, value: jsonFrom(flow)})) }
        for name, schema in code.records { print(jsonFrom(Item{kind: "record", name, value: jsonFrom(schema)})) }
        for name, schema in code.enums { print(jsonFrom(Item{kind: "enum", name, value: jsonFrom(schema)})) }
        for index, constant in code.constants { print(jsonFrom(Item{kind: "constant", name: string(index), value: constant})) }
        for name, function in code.functions {
            print(jsonFrom(FunctionHeader{kind: "function", name, params: function.params, captures: function.captures, locals: function.locals, result: function.result}))
            for instruction in function.instructions {
                let key = state.Key(instruction.module, instruction.node)
                if !spans.has(key) {
                    let id = len(spans)
                    spans[key] = id
                    print(jsonFrom(Item{kind: "span", name: string(id), value: jsonFrom(instruction.span)}))
                }
                let compact = CompactInstruction{op: instruction.op, arg: instruction.arg, module: instruction.module, node: instruction.node, span: spans[key]}
                print(jsonFrom(Item{kind: "instruction", name, value: jsonFrom(compact)}))
                instructions += 1
            }
        }
        print(jsonFrom(End{kind: "end", flows: len(code.flows), records: len(code.records), enums: len(code.enums), constants: len(code.constants), functions: len(code.functions), instructions, spans: len(spans)}))
    } else { print(jsonFrom(End{kind: "end", flows: 0, records: 0, enums: 0, constants: 0, functions: 0, instructions: 0, spans: 0})) }
}
