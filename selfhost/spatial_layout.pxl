import "failures.pxl" as failures
// Region order is semantic statement order; parent IDs refer to earlier regions.
export record Region { colors: [[int]], parent: int }
export record Pixel { position: [int], rgba: [int] }
export record PixelLink { kind: string, from: [int], to: [int] }
export record Spatial { links: [PixelLink] }
export record Source { magic: string, versions: map[string, string], encoding: string, dimensions: [int], pixels: [Pixel], spatial: Spatial, metadata: map[string, json] }
export fn Build(regions: [Region], spacing: int, reverse: bool) -> Result[Source, Error] {
    if spacing < 1 || spacing > 256 { return .Err(failures.New("Spatial spacing must be from 1 to 256")) }
    if len(regions) > 500000 { return .Err(failures.New("Spatial canvas exceeds one million cells")) }
    var depths: [int] = []
    var width = 1
    var height = 1
    for index, region in regions {
        if len(region.colors) == 0 { return .Err(failures.New("A semantic region must contain at least one pixel")) }
        if region.parent < -1 || region.parent >= index { return .Err(failures.New("Region parent must be absent or an earlier region")) }
        var depth = 0
        if region.parent >= 0 { depth = depths[region.parent] + 1 }
        depths.append(depth)
        let right = depth * 2 + (len(region.colors) - 1) * spacing + 1
        if right > width { width = right }
        height = index * 2 + 1
        if width > 1000000 / height { return .Err(failures.New("Spatial canvas exceeds one million cells")) }
    }
    var pixels: [Pixel] = []
    var links: [PixelLink] = []
    var anchors: [[int]] = []
    for index, region in regions {
        var positions: [[int]] = []
        for ordinal, color in region.colors {
            if len(color) != 4 { return .Err(failures.New("Semantic RGBA must contain four bytes")) }
            for channel in color { if channel < 0 || channel > 255 { return .Err(failures.New("RGBA channels must be bytes")) } }
            if color[3] != 255 { return .Err(failures.New("Semantic region pixels must be opaque")) }
            var column = ordinal
            if reverse { column = len(region.colors) - 1 - ordinal }
            let position = [depths[index] * 2 + column * spacing, index * 2]
            pixels.append(Pixel{position, rgba: slice(color, 0, 4)})
            if ordinal > 0 { links.append(PixelLink{kind: "next", from: positions[ordinal - 1], to: position}) }
            positions.append(position)
        }
        links.append(PixelLink{kind: "region", from: positions[0], to: positions[0]})
        anchors.append(positions[0])
        if region.parent >= 0 { links.append(PixelLink{kind: "child", from: anchors[region.parent], to: positions[0]}) }
    }
    return .Ok(Source{magic: "PIXELLANG", versions: map[string, string]{"language": "0.9", "encoding": "0.9", "format": "0.9"}, encoding: "rgba8", dimensions: [width, height], pixels: pixels, spatial: Spatial{links: links}, metadata: map[string, json]{}})
}

// Each explicit region is one token chain; row-major marker order preserves
// statement order, while child links preserve scope independently of indentation.
export fn Compact(regions: [Region]) -> Result[Source, Error] {
    if len(regions) == 0 { return Build([], 1, false) }
    var area = 0
    var width = 1
    for index, region in regions {
        if len(region.colors) == 0 || region.parent < -1 || region.parent >= index { return .Err(failures.New("Invalid compact region")) }
        area += len(region.colors) + 2
        if area > 1000000 { return .Err(failures.New("Compact source exceeds logical cell limit")) }
        if len(region.colors) > width { width = len(region.colors) }
    }
    var target = 1
    while target * target < area { target += 1 }
    if target > width { width = target }
    var pixels: [Pixel] = []
    var links: [PixelLink] = []
    var anchors: [[int]] = []
    var x = 0
    var y = 0
    for region in regions {
        if x > 0 && len(region.colors) > width - x { x = 0; y += 1 }
        if width > 1000000 / (y + 1) { return .Err(failures.New("Compact source exceeds logical cell limit")) }
        let anchor = [x, y]
        links.append(PixelLink{kind: "region", from: anchor, to: anchor})
        for index, color in region.colors {
            if len(color) != 4 { return .Err(failures.New("Semantic RGBA requires four bytes")) }
            for channel in color { if channel < 0 || channel > 255 { return .Err(failures.New("RGBA channels must be bytes")) } }
            if color[3] != 255 { return .Err(failures.New("Semantic region pixels must be opaque")) }
            let position = [x + index, y]
            pixels.append(Pixel{position, rgba: slice(color, 0, 4)})
        }
        if region.parent >= 0 { links.append(PixelLink{kind: "child", from: anchors[region.parent], to: anchor}) }
        anchors.append(anchor)
        x += len(region.colors) + 2
    }
    return .Ok(Source{magic: "PIXELLANG", versions: map[string, string]{"language": "0.9", "encoding": "0.9", "format": "0.9"}, encoding: "rgba8", dimensions: [width, y + 1], pixels: pixels, spatial: Spatial{links: links}, metadata: map[string, json]{}})
}

export fn Empty() -> Source {
    return Source{magic: "PIXELLANG", versions: map[string, string]{"language": "0.9", "encoding": "0.9", "format": "0.9"}, encoding: "rgba8", dimensions: [1, 1], pixels: [], spatial: Spatial{links: []}, metadata: map[string, json]{}}
}
