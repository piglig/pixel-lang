import "debug_info.pxl" as debugInfo
import "model.pxl" as model
import "pixel_ast_flow.pxl" as flowPixels
import "instances.pxl" as instances
import "spatial_layout.pxl" as layout
import "pixel_ast_state.pxl" as state
import "pixel_ast_expr.pxl" as expression
import "literal_pixels.pxl" as literals
import "pixel_tokens.pxl" as tokens

export record Bundle { version: string, entry: string, modules: map[string, layout.Source] }
export record Document { magic: string, versions: map[string, string], encoding: string, dimensions: [int], pixels: [layout.Pixel], spatial: layout.Spatial, metadata: map[string, json], bundle: Bundle }
export record Output { source: Document, diagnostics: [model.Diagnostic] }
fn DocumentFrom(source: layout.Source, bundle: Bundle) -> Document {
    return Document{magic: source.magic, versions: source.versions, encoding: source.encoding, dimensions: source.dimensions, pixels: source.pixels, spatial: source.spatial, metadata: source.metadata, bundle}
}
fn Print(node: int, checked: model.ExpressionCheck, c: inout state.Context, colors: inout [[int]]) -> bool {
    let nodes = checked.resolved.bound.project.modules[c.module].syntax.nodes
    let value = nodes[node]
    if value.kind != "call" { return false }
    let callee = value.children[0]
    if !c.references.has(string(callee)) { return false }
    let symbol = checked.resolved.bound.symbols[c.references[string(callee)]]
    if symbol.kind != "builtin" || symbol.name != "print" { return false }
    state.Token(64, "print", node, checked, &c, &colors); expression.Emit(value.children[1], checked, &c, &colors); return true
}
fn Statement(index: int, parent: int, exported: bool, entry: int, checked: model.ExpressionCheck, c: inout state.Context) {
    if len(c.diagnostics) > 0 { return }
    let resolved = checked.resolved
    let nodes = resolved.bound.project.modules[c.module].syntax.nodes
    let node = nodes[index]
    let children = node.children
    if node.kind == "export" { Statement(children[0], parent, true, entry, checked, &c); return }
    if node.kind == "block" { for child in children { Statement(child, parent, false, entry, checked, &c) }; return }
    var colors: [[int]] = []
    if node.kind == "value_block" {
        state.Token(64, "value_body", index, checked, &c, &colors)
        state.Id(index, index, checked, &c, &colors)
        let row = state.Row(colors, -1, index, &c)
        for child in children { Statement(child, row, false, entry, checked, &c) }
        return
    }
    if node.kind == "block_result" {
        state.Token(64, "block_result", index, checked, &c, &colors)
        expression.Emit(children[0], checked, &c, &colors)
        state.Row(colors, parent, index, &c); return
    }
    if node.kind == "import" {
        let module = resolved.bound.project.modules[c.module]
        for imported in module.imports {
            if imported.node != index { continue }
            for target, item in resolved.bound.project.modules {
                if item.path != imported.target { continue }
                state.Import(target, index, checked, &c); return
            }
        }
        state.Report(index, "Missing pixel import target", checked, &c); return
    }
    if node.kind == "frame" {
        if exported { state.Token(64, "export", index, checked, &c, &colors) }
        state.Token(64, "frame", index, checked, &c, &colors); state.Id(state.Declare(index, checked, &c), index, checked, &c, &colors)
        state.Token(80, "=", index, checked, &c, &colors)
        state.Text(nodes[children[0]].text, index, checked, &c, &colors)
        state.Row(colors, parent, index, &c); return
    }
    if model.CallableDeclaration(node.kind) || node.kind == "lambda" {
        var typeId = -1
        if node.kind == "lambda" {
            typeId = state.ExpressionType(index, checked, &c)
            var marker = "lambda_body"
            if node.text == "effect" { marker = "effect_body" }
            state.Token(64, marker, index, checked, &c, &colors); state.Id(index, index, checked, &c, &colors)
        } else {
            let symbol = state.Declare(index, checked, &c)
            if symbol < 0 { return }
            typeId = resolved.bound.symbols[symbol].typeId
            if exported { state.Token(64, "export", index, checked, &c, &colors) }
            if symbol == entry { state.Token(64, "entry", index, checked, &c, &colors) }
            var marker = node.kind
            if model.Effectful(nodes, index) { marker = "effect_fn" }
            state.Token(64, marker, index, checked, &c, &colors); state.Id(symbol, index, checked, &c, &colors)
            for signature in resolved.signatures { if signature.module == c.module && signature.node == index { state.Generics(signature.parameters, index, checked, &c, &colors) } }
        }
        if typeId < 0 { return }
        let typ = resolved.types[typeId]
        if node.kind == "flow" { state.Token(80, "(", index, checked, &c, &colors) }
        var initialCount = 0
        for child in children {
            if nodes[child].kind != "initial_parameter" { continue }
            if initialCount > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            let parameter = state.Declare(child, checked, &c)
            if parameter < 0 { return }
            state.Id(parameter, child, checked, &c, &colors); state.Token(80, ":", index, checked, &c, &colors)
            state.Type(resolved.bound.symbols[parameter].typeId, child, checked, &c, &colors)
            initialCount += 1
        }
        if node.kind == "flow" {
            state.Token(80, ")", index, checked, &c, &colors)
            state.Token(64, "step", index, checked, &c, &colors)
        }
        state.Token(80, "(", index, checked, &c, &colors)
        var count = 0
        for child in children {
            if nodes[child].kind != "parameter" { continue }
            if count > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            let parameter = state.Declare(child, checked, &c)
            if parameter < 0 { return }
            state.Id(parameter, child, checked, &c, &colors); state.Token(80, ":", index, checked, &c, &colors)
            state.Type(typ.arguments[count], child, checked, &c, &colors)
            count += 1
        }
        state.Token(80, ")", index, checked, &c, &colors); state.Token(80, "->", index, checked, &c, &colors)
        state.Type(typ.arguments[len(typ.arguments) - 1], index, checked, &c, &colors)
        let row = state.Row(colors, parent, index, &c)
        if node.kind == "flow" { flowPixels.Emit(index, row, checked, &c) }
        else { Statement(children[len(children) - 1], row, false, entry, checked, &c) }
        return
    }
    if node.kind == "record" || node.kind == "enum" {
        let symbol = state.Declare(index, checked, &c)
        if symbol < 0 { return }
        if exported { state.Token(64, "export", index, checked, &c, &colors) }
        state.Token(64, node.kind, index, checked, &c, &colors); state.Id(symbol, index, checked, &c, &colors)
        let typ = resolved.types[resolved.bound.symbols[symbol].typeId]
        state.Generics(typ.arguments, index, checked, &c, &colors)
        state.Token(80, "(", index, checked, &c, &colors)
        for position, field in typ.fields {
            if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            state.Text(field.name, index, checked, &c, &colors)
            state.Token(80, ":", index, checked, &c, &colors); state.Type(field.typeId, index, checked, &c, &colors)
        }
        for position, variant in typ.variants {
            if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            state.Text(variant.name, index, checked, &c, &colors)
            state.Token(80, "(", index, checked, &c, &colors)
            for fieldIndex, field in variant.fields {
                if fieldIndex > 0 { state.Token(80, ",", index, checked, &c, &colors) }
                state.Text(field.name, index, checked, &c, &colors)
                state.Token(80, ":", index, checked, &c, &colors); state.Type(field.typeId, index, checked, &c, &colors)
            }
            state.Token(80, ")", index, checked, &c, &colors)
        }
        state.Token(80, ")", index, checked, &c, &colors)
    } else if node.kind == "match_stmt" {
        state.Token(64, "match", index, checked, &c, &colors); expression.Subjects(children[0], checked, &c, &colors)
        let row = state.Row(colors, parent, index, &c)
        for armId in slice(children, 1, len(children)) {
            let arm = nodes[armId]
            var pattern: [[int]] = []
            state.Token(64, "case", armId, checked, &c, &pattern); expression.Patterns(armId, checked, &c, &pattern)
            let caseRow = state.Row(pattern, row, armId, &c)
            Statement(arm.children[len(arm.children) - 1], caseRow, false, entry, checked, &c)
        }
        return
    } else if node.kind == "let" || node.kind == "var" {
        let symbol = state.Declare(index, checked, &c)
        if symbol < 0 { return }
        state.Token(64, node.kind, index, checked, &c, &colors); state.Id(symbol, index, checked, &c, &colors); state.Token(80, ":", index, checked, &c, &colors)
        state.Type(resolved.bound.symbols[symbol].typeId, index, checked, &c, &colors); state.Token(80, "=", index, checked, &c, &colors)
        expression.Emit(children[len(children) - 1], checked, &c, &colors)
    } else if node.kind == "assign" {
        state.Token(64, "set", index, checked, &c, &colors); expression.Emit(children[0], checked, &c, &colors)
        state.Token(80, node.text, index, checked, &c, &colors)
        expression.Emit(children[1], checked, &c, &colors)
    } else if node.kind == "return" || node.kind == "expression_body" {
        state.Token(64, "return", index, checked, &c, &colors)
        if len(children) > 0 { expression.Emit(children[0], checked, &c, &colors) }
    } else if node.kind == "expression_stmt" {
        if !Print(children[0], checked, &c, &colors) { state.Token(64, "do", index, checked, &c, &colors); expression.Emit(children[0], checked, &c, &colors) }
    } else if node.kind == "if" || node.kind == "while" {
        state.Token(64, node.kind, index, checked, &c, &colors); expression.Emit(children[0], checked, &c, &colors)
        let row = state.Row(colors, parent, index, &c)
        Statement(children[1], row, false, entry, checked, &c)
        if len(children) > 2 {
            var otherwise: [[int]] = []
            state.Token(64, "else", index, checked, &c, &otherwise)
            let otherRow = state.Row(otherwise, parent, index, &c)
            Statement(children[2], otherRow, false, entry, checked, &c)
        }
        return
    } else if node.kind == "for" {
        state.Token(64, "for", index, checked, &c, &colors)
        var position = 0
        while position < len(children) - 2 {
            if position > 0 { state.Token(80, ",", index, checked, &c, &colors) }
            state.Id(state.Declare(children[position], checked, &c), index, checked, &c, &colors); position += 1
        }
        state.Token(64, "in", index, checked, &c, &colors); expression.Emit(children[len(children) - 2], checked, &c, &colors)
        let row = state.Row(colors, parent, index, &c)
        Statement(children[len(children) - 1], row, false, entry, checked, &c); return
    } else if node.kind == "break" || node.kind == "continue" { state.Token(64, node.kind, index, checked, &c, &colors) }
    else { state.Report(index, "Statement pixel emission is not implemented: " + node.kind, checked, &c); return }
    state.Row(colors, parent, index, &c)
}
export fn Build(checked: model.ExpressionCheck) -> Output { return BuildOptions(0, checked) }
export fn BuildMapped(checked: model.ExpressionCheck) -> Output { return BuildOptions(2, checked) }
export fn BuildNamed(checked: model.ExpressionCheck) -> Output { return BuildOptions(1, checked) }
fn BuildOptions(mapped: int, input: model.ExpressionCheck) -> Output {
    let planned = instances.Build(input)
    let checked = planned.checked
    let modules = checked.resolved.bound.project.modules
    var bundle: Bundle = Bundle{version: "0.9", entry: "main.pxl", modules: map[string, layout.Source]{}}
    if len(modules) > 0 { bundle.entry = modules[len(modules) - 1].path }
    let empty = DocumentFrom(layout.Empty(), bundle)
    if len(planned.diagnostics) > 0 { return Output{source: empty, diagnostics: planned.diagnostics} }
    let entry = planned.instances[planned.entry].symbol
    var calls: map[string, int] = map[string, int]{}
    for index, call in checked.calls {
        let key = state.Key(call.module, call.node)
        if len(call.arguments) > 0 && !calls.has(key) { calls[key] = index }
    }
    var annotations: map[string, int] = map[string, int]{}
    for annotation in checked.resolved.annotations {
        let key = state.Key(annotation.module, annotation.node)
        if !annotations.has(key) { annotations[key] = annotation.typeId }
    }
    var symbolIds: map[string, int] = map[string, int]{}
    for index, symbol in checked.resolved.bound.symbols {
        let key = state.Key(symbol.module, symbol.node)
        if !symbolIds.has(key) { symbolIds[key] = index }
    }
    let callIndex = calls
    let annotationIndex = annotations
    let symbolIndex = symbolIds
    let tokenIndices = tokens.Index()
    // Group row indices once instead of scanning every project's table per module.
    var referenceGroups: [[int]] = []
    var symbolGroups: [[int]] = []
    var expressionGroups: [[int]] = []
    let emptyGroup: [int] = []
    for source in modules {
        referenceGroups.append(emptyGroup)
        symbolGroups.append(emptyGroup)
        expressionGroups.append(emptyGroup)
    }
    for index, reference in checked.resolved.bound.references {
        if reference.module >= 0 && reference.module < len(modules) { referenceGroups[reference.module].append(index) }
    }
    for index, symbol in checked.resolved.bound.symbols {
        if symbol.module >= 0 && symbol.module < len(modules) { symbolGroups[symbol.module].append(index) }
    }
    for index, item in checked.expressions {
        if item.module >= 0 && item.module < len(modules) { expressionGroups[item.module].append(index) }
    }
    var main = layout.Empty()
    for module, source in modules {
        var c: state.Context = state.Context{module, regions: [], origins: [], references: map[string, int]{}, declarations: map[string, int]{}, expressions: map[string, int]{}, calls: callIndex, annotations: annotationIndex, symbolIds: symbolIndex, tokenIndices, bodies: [], imports: map[string, bool]{}, diagnostics: []}
        for index in referenceGroups[module] {
            let reference = checked.resolved.bound.references[index]
            c.references[string(reference.node)] = reference.symbol
        }
        for index in symbolGroups[module] {
            let symbol = checked.resolved.bound.symbols[index]
            c.declarations[string(symbol.node)] = index
        }
        for index in expressionGroups[module] {
            let item = checked.expressions[index]
            c.expressions[string(item.node)] = item.typeId
        }
        for root in source.syntax.roots { Statement(root, -1, false, entry, checked, &c) }
        var bodyIndex = 0
        while bodyIndex < len(c.bodies) && len(c.diagnostics) == 0 {
            Statement(c.bodies[bodyIndex], -1, false, entry, checked, &c)
            bodyIndex += 1
        }
        if len(c.diagnostics) > 0 { return Output{source: empty, diagnostics: c.diagnostics} }
        let regions = c.regions
        var document = layout.Empty()
        match layout.Compact(regions) {
            .Ok(value) => { document = value },
            .Err(error) => { return Output{source: empty, diagnostics: [model.Diagnostic{source: source.path, phase: "pixels", message: error.message, start: 0, end: 0, line: 1, column: 1}]} }
        }
        if mapped > 0 {
            document.metadata["filename"] = jsonFrom(source.path)
            if mapped == 2 { debugInfo.MapDocument(source, &document, regions, c.origins) }
            var symbols: map[string, string] = map[string, string]{}
            for id, symbol in checked.resolved.bound.symbols { if symbol.module == module { symbols[string(id)] = symbol.name } }
            document.metadata["symbols"] = jsonFrom(symbols)
        }
        if module == len(modules) - 1 { main = document }
        else { bundle.modules[string(state.ModuleId(module, checked))] = document }
    }
    return Output{source: DocumentFrom(main, bundle), diagnostics: []}
}
