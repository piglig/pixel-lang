import "model.pxl" as model
import "spatial_layout.pxl" as layout
import "pixel_decode.pxl" as decoder
import "pixel_regions.pxl" as regions
import "pixel_statements.pxl" as statements

record Builder { entryName: string, sources: map[string, layout.Source], decoded: map[string, decoder.Output], parsed: map[string, statements.Output], states: map[string, int], modules: [model.Module], diagnostics: [model.Diagnostic] }
fn Path(id: int) -> string = "_module_" + string(id) + ".pxl"
fn Report(b: inout Builder, source: string, message: string, token: model.Token) {
    b.diagnostics.append(model.Diagnostic{source, phase: "pixel-project", message, start: token.start, end: token.end, line: token.line, column: token.column})
}
fn Origin() -> model.Token = model.Token{kind: "pixel", text: "", value: "", start: 0, end: 0, line: 1, column: 1}
fn Visit(b: inout Builder, id: int, source: string, origin: model.Token) {
    let key = string(id)
    if b.states.has(key) {
        if b.states[key] == 1 { Report(&b, source, "Cyclic pixel module import: " + key, origin) }
        return
    }
    if !b.sources.has(key) && !b.parsed.has(key) { Report(&b, source, "Missing pixel module: " + key, origin); return }
    b.states[key] = 1
    let path = Path(id)
    var parsed = statements.Output{syntax: model.Parsed{tokens: [], nodes: [], roots: [], diagnostics: []}, diagnostics: [], entries: []}
    if b.parsed.has(key) { parsed = b.parsed[key] }
    else {
        let document = b.sources[key]
        var decoded = decoder.Output{tokens: [], diagnostics: []}
        if b.decoded.has(key) { decoded = b.decoded[key] }
        else { decoded = decoder.Decode(document, path) }
        parsed = statements.Parse(regions.Analyze(decoded, document.spatial.links, path), path, id)
    }
    for error in parsed.diagnostics {
        var line = 1
        var column = 1
        if len(error.position) == 2 { line = error.position[1] + 1; column = error.position[0] + 1 }
        b.diagnostics.append(model.Diagnostic{source: error.source, phase: error.phase, message: error.message, start: 0, end: 0, line, column})
    }
    if len(parsed.diagnostics) > 0 { b.states[key] = 2; return }
    if (id == 0 && len(parsed.entries) != 1) || (id != 0 && len(parsed.entries) != 0) {
        Report(&b, path, "Program requires exactly one entry in the root module", Origin()); b.states[key] = 2; return
    }
    if id == 0 { b.entryName = parsed.syntax.nodes[parsed.entries[0]].text }
    var declarations: [model.Declaration] = []
    var imports: [model.Import] = []
    for root in parsed.syntax.roots {
        var index = root
        var exported = false
        if parsed.syntax.nodes[index].kind == "export" { exported = true; index = parsed.syntax.nodes[index].children[0] }
        let node = parsed.syntax.nodes[index]
        let token = parsed.syntax.tokens[node.start]
        if node.kind == "import" {
            let alias = parsed.syntax.nodes[node.children[0]].text
            if len(alias) <= 8 { Report(&b, path, "Invalid pixel import alias", token); continue }
            match parseInt(slice(alias, 8, len(alias))) {
                .Ok(target) => {
                    imports.append(model.Import{alias, target: Path(target), node: index})
                    Visit(&b, target, path, token)
                },
                .Err(error) => { Report(&b, path, "Invalid pixel import alias: " + alias, token) }
            }
        } else if model.CallableDeclaration(node.kind) || node.kind == "frame" || node.kind == "record" || node.kind == "enum" {
            declarations.append(model.Declaration{name: node.text, kind: node.kind, node: index, exported})
        } else { Report(&b, path, "Modules may contain declarations only", token) }
    }
    b.states[key] = 2
    b.modules.append(model.Module{path, syntax: parsed.syntax, imports: imports, declarations: declarations})
}
export fn Build(main: layout.Source, modules: map[string, layout.Source]) -> model.Project = BuildDecoded(main, modules, map[string, decoder.Output]{})
// Internal fast path: decoded outputs belong to these exact validated documents.
export fn BuildDecoded(main: layout.Source, modules: map[string, layout.Source], decoded: map[string, decoder.Output]) -> model.Project {
    var b: Builder = Builder{entryName: "", sources: map[string, layout.Source]{"0": main}, decoded, parsed: map[string, statements.Output]{}, states: map[string, int]{}, modules: [], diagnostics: []}
    if len(modules) > 127 { Report(&b, Path(0), "Pixel project exceeds 128 modules", Origin()); return model.Project{entryName: b.entryName, modules: [], diagnostics: b.diagnostics} }
    for key, source in modules {
        var id = -1
        match parseInt(key) { .Ok(value) => { id = value }, .Err(error) => { Report(&b, Path(0), "Invalid pixel module ID: " + key, Origin()); continue } }
        if id < 1 || id > 65535 || string(id) != key { Report(&b, Path(0), "Invalid pixel module ID: " + key, Origin()) }
        else { b.sources[key] = source }
    }
    if len(b.diagnostics) == 0 { Visit(&b, 0, Path(0), Origin()) }
    if len(b.diagnostics) > 0 { b.modules = [] }
    return model.Project{entryName: b.entryName, modules: b.modules, diagnostics: b.diagnostics}
}

// Internal transport boundary for independently parsed, version-matched modules.
export fn BuildParsed(parsed: map[string, statements.Output]) -> model.Project {
    var b: Builder = Builder{entryName: "", sources: map[string, layout.Source]{}, decoded: map[string, decoder.Output]{}, parsed, states: map[string, int]{}, modules: [], diagnostics: []}
    if len(parsed) < 1 || len(parsed) > 128 { Report(&b, Path(0), "Pixel project requires 1..128 modules", Origin()) }
    for key in parsed.keys() {
        var id = -1
        match parseInt(key) { .Ok(value) => { id = value }, .Err(error) => { Report(&b, Path(0), "Invalid parsed module ID", Origin()); continue } }
        if id < 0 || id > 65535 || string(id) != key { Report(&b, Path(0), "Invalid parsed module ID", Origin()) }
    }
    if len(b.diagnostics) == 0 { Visit(&b, 0, Path(0), Origin()) }
    if len(b.diagnostics) > 0 { b.modules = [] }
    return model.Project{entryName: b.entryName, modules: b.modules, diagnostics: b.diagnostics}
}
