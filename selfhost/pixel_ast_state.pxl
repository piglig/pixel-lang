import "model.pxl" as model
import "spatial_layout.pxl" as layout
import "pixel_tokens.pxl" as tokens

export record Context { checked: model.ExpressionCheck, module: int, regions: [layout.Region], origins: [int], references: map[int], declarations: map[int], expressions: map[int], calls: map[int], annotations: map[int], symbolIds: map[int], lambdas: [int], imports: map[bool], diagnostics: [model.Diagnostic] }
export fn Key(module: int, node: int) -> string = string(module) + ":" + string(node)
export fn Report(c: Context, index: int, message: string) {
    let source = c.checked.resolved.bound.project.modules[c.module]
    let node = source.syntax.nodes[index]
    var line = 1
    var column = 1
    for token in source.syntax.tokens { if token.start >= node.start { line = token.line; column = token.column; break } }
    append(c.diagnostics, model.Diagnostic{source: source.path, phase: "pixels", message, start: node.start, end: node.end, line, column})
}
export fn Token(colors: [[int]], category: int, name: string) { append(colors, tokens.Symbol(category, name)) }
export fn Id(c: Context, colors: [[int]], symbol: int, node: int) {
    if symbol < 0 || symbol > 65535 { Report(c, node, "Pixel symbol identity exceeds 16-bit range"); return }
    append(colors, tokens.Identifier(symbol))
}
export fn ModuleId(c: Context, module: int) -> int {
    if module == len(c.checked.resolved.bound.project.modules) - 1 { return 0 }
    return module + 1
}
export fn Declare(c: Context, node: int) -> int {
    let key = string(node)
    if has(c.declarations, key) { return c.declarations[key] }
    Report(c, node, "Missing declaration identity")
    return -1
}
export fn Reference(c: Context, node: int) -> int {
    let key = string(node)
    if has(c.references, key) { return c.references[key] }
    Report(c, node, "Missing reference identity")
    return -1
}
export fn Row(c: Context, colors: [[int]], parent: int, node: int) -> int {
    let index = len(c.regions)
    if len(colors) == 0 { return parent }
    append(c.regions, layout.Region{colors, parent}); append(c.origins, node)
    return index
}
export fn Import(c: Context, module: int, node: int) {
    if module == c.module || has(c.imports, string(module)) { return }
    c.imports[string(module)] = true
    let colors: [[int]] = []
    Token(colors, 64, "import"); Id(c, colors, ModuleId(c, module), node)
    Row(c, colors, -1, node)
}
export fn Type(c: Context, colors: [[int]], typeId: int, node: int) {
    if typeId < 0 { Report(c, node, "Missing pixel type"); return }
    let typ = c.checked.resolved.types[typeId]
    if typ.kind == "type_parameter" {
        Token(colors, 96, "parameter"); Token(colors, 80, "(")
        Id(c, colors, len(c.checked.resolved.bound.symbols) + typeId, node)
        Token(colors, 80, ")"); return
    }
    if typ.kind == "primitive" {
        var name = typ.name
        if name == "string" { name = "str" }
        Token(colors, 96, name); return
    }
    if typ.kind == "array" { Type(c, colors, typ.arguments[0], node); Token(colors, 80, "["); Token(colors, 80, "]"); return }
    if typ.kind == "map" { Token(colors, 96, "map"); Token(colors, 80, "("); Type(c, colors, typ.arguments[0], node); Token(colors, 80, ")"); return }
    if typ.kind == "function" {
        Token(colors, 96, "function"); Token(colors, 80, "(")
        var index = 0
        while index < len(typ.arguments) - 1 {
            if index > 0 { Token(colors, 80, ",") }
            Type(c, colors, typ.arguments[index], node); index += 1
        }
        Token(colors, 80, ")"); Token(colors, 80, "->"); Token(colors, 80, "(")
        Type(c, colors, typ.arguments[len(typ.arguments) - 1], node); Token(colors, 80, ")"); return
    }
    if typ.module == -1 && typ.name == "Error" { Token(colors, 96, "Error"); return }
    if typ.module == -1 && typ.name == "Option" { Token(colors, 96, "Option"); Token(colors, 80, "("); Type(c, colors, typ.arguments[0], node); Token(colors, 80, ")"); return }
    if (typ.kind == "record" || typ.kind == "enum") && typ.module >= 0 {
        Import(c, typ.module, node)
        var symbol = -1
        let key = Key(typ.module, typ.declaration)
        if has(c.symbolIds, key) { symbol = c.symbolIds[key] }
        Token(colors, 96, "record"); Token(colors, 80, "("); Id(c, colors, ModuleId(c, typ.module), node); Token(colors, 80, "."); Id(c, colors, symbol, node)
        if len(typ.arguments) > 0 {
            Token(colors, 80, "[")
            for index, argument in typ.arguments { if index > 0 { Token(colors, 80, ",") }; Type(c, colors, argument, node) }
            Token(colors, 80, "]")
        }
        Token(colors, 80, ")"); return
    }
    Report(c, node, "Type pixel emission is not implemented: " + typ.kind)
}
export fn ExpressionType(c: Context, node: int) -> int {
    if has(c.expressions, string(node)) { return c.expressions[string(node)] }
    Report(c, node, "Missing expression type for pixels"); return -1
}

export fn Generics(c: Context, colors: [[int]], parameters: [int], node: int) {
    if len(parameters) == 0 { return }
    Token(colors, 80, "[")
    for index, parameter in parameters {
        if index > 0 { Token(colors, 80, ",") }
        Id(c, colors, len(c.checked.resolved.bound.symbols) + parameter, node)
    }
    Token(colors, 80, "]")
}
export fn Annotation(c: Context, node: int) -> int {
    let key = Key(c.module, node)
    if has(c.annotations, key) { return c.annotations[key] }
    Report(c, node, "Missing type annotation for pixels"); return -1
}
