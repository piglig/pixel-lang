import "error.pxl" as errors
// CSV records. Quoted commas, escaped quotes, multiline fields and Unicode are preserved.
// Malformed CSV is a typed result with a stable code and character offset.
export fn Parse(text: string) -> Result[[[string]], Error] {
    var rows: [[string]] = []
    var row: [string] = []
    var field = ""
    var state = 0
    var i = 0
    var pending = false
    while i < len(text) {
        let c = text[i]
        pending = true
        if state == 2 {
            if c == "\"" { state = 3 } else { field = field + c }
        } else {
            if c == "\"" {
                if state == 3 { field = field + "\""; state = 2 } else {
                    if state == 0 { state = 2 } else { return .Err(errors.New("csv.unexpected_quote", "CSV quote inside unquoted field", "Parse", string(i))) }
                }
            } else {
                if c == "," {
                    row.append(field)
                    field = ""
                    state = 0
                } else {
                    if c == "\n" || c == "\r" {
                        row.append(field)
                        rows.append(row)
                        row = []: [string]
                        field = ""
                        state = 0
                        pending = false
                        if c == "\r" && i + 1 < len(text) && text[i + 1] == "\n" { i += 1 }
                    } else {
                        if state == 3 { return .Err(errors.New("csv.trailing_character", "CSV character after closing quote", "Parse", string(i))) }
                        field = field + c
                        state = 1
                    }
                }
            }
        }
        i += 1
    }
    if state == 2 { return .Err(errors.New("csv.unterminated_quote", "CSV unterminated quoted field", "Parse", string(len(text)))) }
    if pending { row.append(field); rows.append(row) }
    return .Ok(rows)
}

export fn Encode(rows: [[string]]) -> Result[string, Error] {
    var result = ""
    for index, row in rows {
        if len(row) == 0 { return .Err(errors.New("csv.empty_row", "CSV rows require at least one field", "Encode", string(index))) }
        var fields: [string] = []
        for value in row {
            fields.append("\"" + replace(value, "\"", "\"\"") + "\"")
        }
        result = result + join(fields, ",") + "\r\n"
    }
    return .Ok(result)
}
