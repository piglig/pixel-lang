// Integer statistics. Mean truncates toward zero; no implicit floating point.
export fn Summary(values: [int]) -> Option[map[string, int]] {
    if len(values) == 0 { return Option.None }
    var total = 0
    var minimum = values[0]
    var maximum = values[0]
    for value in values {
        total += value
        if value < minimum { minimum = value }
        if value > maximum { maximum = value }
    }
    return Option.Some(map[string, int]{"count": len(values), "total": total, "min": minimum, "max": maximum, "mean": total / len(values)})
}
