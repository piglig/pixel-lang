import "../sort.pxl" as sort

fn main() {
    var values = [3, -2, 3, 0]
    sort.InsertionSort(&values)
    assert(values[0] == -2)
    assert(values[1] == 0)
    assert(values[2] == 3)
    assert(values[3] == 3)
    var empty: [int] = []
    sort.InsertionSort(&empty)
    assert(len(empty) == 0)
}
