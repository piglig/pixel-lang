import "models.pxl" as models
import "std/stats.pxl" as stats
import "std/collections.pxl" as collections

export fn Summarize(sales: [models.Sale], problems: [models.Problem], filtered: int) -> models.Report {
    var categories: map[string, [int]] = map[string, [int]]{}
    for sale in sales {
        if !categories.has(sale.category) { categories[sale.category] = []: [int] }
        categories[sale.category].append(sale.amount)
    }
    var groups: [models.Group] = []
    for category in categories {
        match stats.Summary(categories[category]) {
            Option.Some(summary) => {
                groups.append(models.Group{
                    category,
                    count: summary["count"], total: summary["total"],
                    min: summary["min"], max: summary["max"],
                    mean: float64(summary["total"]) / float64(summary["count"]),
                })
            },
            Option.None => {}
        }
    }
    return models.Report{
        accepted: len(sales), rejected: len(problems), filtered: filtered,
        groups: collections.SortedBy(groups, fn(a, b) = a.total > b.total || (a.total == b.total && a.category < b.category)), errors: problems,
    }
}
