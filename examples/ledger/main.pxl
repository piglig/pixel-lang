import "config.pxl" as config
import "models.pxl" as models
import "rows.pxl" as rows
import "report.pxl" as report
import "std/csv.pxl" as csv
import "std/io.pxl" as io
import "std/json.pxl" as json

effect fn main() {
    match Run(input()) {
        .Ok(result) => { print(result) },
        .Err(error) => { print(error) }
    }
}

effect fn Run(text: string) -> Result[models.Report, Error] {
    let settings = config.Parse(text)?
    let records = csv.Parse(io.Read(settings.source)?)?
    if len(records) > 0 { let header = rows.Header(records[0])? }
    var sales: [models.Sale] = []
    var problems: [models.Problem] = []
    var filtered = 0
    for index, fields in records {
        let row_number = index + 1
        if row_number > 1 {
            match rows.Parse(fields) {
                .Ok(sale) => {
                    if config.Includes(settings, sale) { sales.append(sale) } else { filtered += 1 }
                },
                .Err(problem) => { problems.append(models.Problem{row: row_number, message: problem.message}) }
            }
        }
    }
    let result = report.Summarize(sales, problems, filtered)
    let written = io.Write(settings.output, json.Stringify(jsonFrom(result)) + "\n")?
    return .Ok(result)
}
