import "std/error.pxl" as errors
import "models.pxl" as models

record Input { source: string, output: string, categories: Option[[string]], minimum_minor: Option[int], maximum_minor: Option[int] }

export fn Parse(text: string) -> Result[models.Config, Error] {
    let requested = jsonDecode::[Input](text)?
    let categories = match requested.categories { Option.Some(values) => values, Option.None => ([]: [string]) }
    let minimum = match requested.minimum_minor { Option.Some(value) => value, Option.None => 0 }
    match requested.maximum_minor {
        Option.Some(maximum) => {
            if maximum < minimum { return .Err(errors.New("ledger.invalid_range", "maximum_minor must be greater than or equal to minimum_minor", "Parse", "")) }
        }
        Option.None => {}
    }
    return .Ok(models.Config{source: requested.source, output: requested.output, categories, minimum, maximum: requested.maximum_minor})
}

export fn Includes(config: models.Config, sale: models.Sale) -> bool {
    if sale.amount < config.minimum { return false }
    match config.maximum {
        Option.Some(maximum) => { if sale.amount > maximum { return false } }
        Option.None => {}
    }
    if len(config.categories) == 0 { return true }
    for category in config.categories {
        if category == sale.category { return true }
    }
    return false
}
