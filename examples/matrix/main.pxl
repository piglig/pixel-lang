fn main() {
    let a = [[1, 2], [3, 4]]
    let b = [[5, 6], [7, 8]]
    let result = [[0, 0], [0, 0]]
    var row = 0
    while row < 2 {
        var col = 0
        while col < 2 {
            var k = 0
            while k < 2 {
                result[row][col] = result[row][col] + a[row][k] * b[k][col]
                k = k + 1
            }
            col = col + 1
        }
        row = row + 1
    }
    print(result)
}
