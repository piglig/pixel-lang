import "model.pxl" as model

export fn Control(previous: model.Status, event: model.Command) -> Result[model.Status, model.Rejection] {
    match event {
        model.Command.Request(floor) => {
            if floor < 0 || floor > 3 { return .Err(.InvalidFloor(floor)) }
            return .Ok(previous with {target: floor, doorsOpen: floor == previous.floor})
        },
        model.Command.Tick => {
            var floor = previous.floor
            if floor != previous.target {
                if previous.doorsOpen { return .Err(.DoorsOpen) }
                if floor < previous.target { floor += 1 } else { floor -= 1 }
            }
            return .Ok(previous with {floor, doorsOpen: floor == previous.target})
        },
        model.Command.Open => {
            if previous.floor != previous.target { return .Err(.InTransit) }
            return .Ok(previous with {doorsOpen: true})
        },
        model.Command.Close => { return .Ok(previous with {doorsOpen: false}) }
    }
}

export fn Arrange(previous: Space[model.Building, string, bool], status: model.Status) -> Space[model.Building, string, bool] {
    var scene = previous
    if scene.size() == 0 {
        for floor in [0, 1, 2, 3] {
            scene = scene.insert(Point3::[model.Building]{x: 1.0, y: float64(floor) * 3.0, z: 0.0}, "floor " + string(floor))
        }
        scene = scene.insert(Point3::[model.Building]{x: 0.0, y: 0.0, z: 0.0}, "cabin")
    }
    let cabin = scene.get(4)
    scene = scene.move(cabin, Point3::[model.Building]{x: 0.0, y: float64(status.floor) * 3.0, z: 0.0})
    for link in scene.outgoing(cabin) { scene = scene.disconnect(link) }
    if status.doorsOpen {
        for floor in scene.neighbors(cabin, 1.1) {
            if floor.id == status.floor { scene = scene.connect(cabin, floor, true) }
        }
    }
    return scene
}

export fn Inspect(status: model.Status, scene: Space[model.Building, string, bool]) -> model.View {
    var floors: [int] = []
    for floor in scene.neighbors(scene.get(4), 1.1) { floors.append(floor.id) }
    return model.View{status, scene, nearbyFloors: floors}
}

export fn Message(rejection: model.Rejection) -> string = match rejection {
    .InvalidFloor(floor) => "Floor must be between 0 and 3",
    .DoorsOpen => "Close the doors before moving",
    .InTransit => "Cannot open doors during a trip"
}
