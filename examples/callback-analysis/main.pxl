import "models.pxl" as models
import "std/collections.pxl" as collections

effect fn main() {
    match jsonDecode::[models.Request](input()) {
        .Ok(request) => { Report(request) },
        .Err(error) => { print(error); assert(false) }
    }
}

effect fn Report(request: models.Request) {
    let minimum = match request.minimum { Option.None => 0.0, Option.Some(value) => value }
    let selected = collections.Filter::[models.Sample](request.samples, fn(sample: models.Sample) -> bool {
        return sample.value >= minimum
    })
    let ordered = collections.SortedBy::[models.Sample](selected, fn(a: models.Sample, b: models.Sample) -> bool {
        return a.value > b.value
    })
    let names = collections.Map::[models.Sample, string](ordered, fn(sample: models.Sample) -> string {
        return sample.name
    })
    let total = collections.Fold::[models.Sample, float64](selected, 0.0, fn(sum: float64, sample: models.Sample) -> float64 {
        return sum + sample.value
    })
    let grouped = collections.GroupBy::[models.Sample, string](selected, fn(sample: models.Sample) -> string {
        return sample.category
    })
    var categories: map[string, int] = map[string, int]{}
    for category, samples in grouped { categories[category] = len(samples) }
    var mean = 0.0
    if len(selected) > 0 { mean = total / float64(len(selected)) }
    print(models.Report{names, mean, categories: categories})
}
