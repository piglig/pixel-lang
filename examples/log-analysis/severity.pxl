import "std/error.pxl" as errors
// Explicit ordering; lexical string order is not severity order.
export fn Rank(level: string) -> Result[int, Error] {
    if level == "INFO" { return .Ok(0) }
    if level == "WARN" { return .Ok(1) }
    if level == "ERROR" { return .Ok(2) }
    return .Err(errors.New("log.invalid_level", "level must be INFO, WARN or ERROR", "Rank", ""))
}

export fn Minimum(level: Option[string]) -> Result[int, Error] = match level {
    Option.Some(value) => Rank(value), Option.None => .Ok(0)
}
