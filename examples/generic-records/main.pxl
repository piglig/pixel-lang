import "models.pxl" as models
import "std/collections.pxl" as collections

effect fn main() {
    match jsonDecode::[models.Batch[models.Sample]](input()) {
        .Ok(batch) => { Report(batch) },
        .Err(error) => { print(error.message) }
    }
}

effect fn Report(batch: models.Batch[models.Sample]) {
    var total = 0.0
    for sample in batch.items {
        total += sample.value
    }
    let count = len(batch.items)
    var mean = 0.0
    if count > 0 {
        mean = total / float64(count)
    }
    print(models.Summary{source: batch.source, count, mean})
}
